{{!
    @template mod_caracterizacion/matrices_list

    Template for displaying the list of characterization matrices.

    Context variables required:
    * matrices - Array of matrix objects
    * cmid - Course module ID
    * candelete - Whether user can delete matrices
    * canedit - Whether user can edit matrices

    @package     mod_caracterizacion
    @copyright   2024 Alonso Arias <soporte@orioncloud.com.co>
    @license     http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="mod-caracterizacion-matrices-list">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">{{#str}}matrices, mod_caracterizacion{{/str}}</h3>
        {{#cancreate}}
        <a href="{{createurl}}" class="btn btn-primary">
            <i class="fa fa-plus mr-2"></i>{{#str}}crearmatriz, mod_caracterizacion{{/str}}
        </a>
        {{/cancreate}}
    </div>

    {{#hasmatrices}}
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>{{#str}}programaacademico, mod_caracterizacion{{/str}}</th>
                    <th>{{#str}}nombredelcurso, mod_caracterizacion{{/str}}</th>
                    <th class="text-center">{{#str}}faseactual, mod_caracterizacion{{/str}}</th>
                    <th class="text-center">{{#str}}estado, mod_caracterizacion{{/str}}</th>
                    <th>{{#str}}creador, mod_caracterizacion{{/str}}</th>
                    <th>{{#str}}fechacreacion, mod_caracterizacion{{/str}}</th>
                    <th class="text-center">{{#str}}acciones, mod_caracterizacion{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#matrices}}
                <tr>
                    <td data-label="{{#str}}programaacademico, mod_caracterizacion{{/str}}">
                        <strong>{{programa_academico}}</strong>
                    </td>
                    <td data-label="{{#str}}nombredelcurso, mod_caracterizacion{{/str}}">
                        {{nombre_curso}}
                    </td>
                    <td data-label="{{#str}}faseactual, mod_caracterizacion{{/str}}" class="text-center">
                        <span class="badge badge-pill badge-primary">{{fase_actual}} / 6</span>
                    </td>
                    <td data-label="{{#str}}estado, mod_caracterizacion{{/str}}" class="text-center">
                        <span class="badge badge-{{estadoclass}}">
                            {{#is_borrador}}<i class="fa fa-pencil mr-1"></i>{{/is_borrador}}
                            {{#is_en_proceso}}<i class="fa fa-spinner mr-1"></i>{{/is_en_proceso}}
                            {{#is_completada}}<i class="fa fa-check mr-1"></i>{{/is_completada}}
                            {{estado}}
                        </span>
                    </td>
                    <td data-label="{{#str}}creador, mod_caracterizacion{{/str}}">
                        <small class="text-muted"><i class="fa fa-user mr-1"></i></small>{{creador}}
                    </td>
                    <td data-label="{{#str}}fechacreacion, mod_caracterizacion{{/str}}">
                        <small class="text-muted"><i class="fa fa-calendar mr-1"></i></small>{{timecreated}}
                    </td>
                    <td data-label="{{#str}}acciones, mod_caracterizacion{{/str}}" class="text-center text-nowrap">
                        <div class="btn-group" role="group">
                            <a href="{{viewurl}}" class="btn btn-sm btn-outline-primary" title="{{#str}}ver, mod_caracterizacion{{/str}}">
                                {{#pix}}i/preview, core{{/pix}}
                            </a>
                            {{#canedit}}
                            <a href="{{editurl}}" class="btn btn-sm btn-outline-secondary" title="{{#str}}editar, mod_caracterizacion{{/str}}">
                                {{#pix}}t/edit, core{{/pix}}
                            </a>
                            {{/canedit}}
                            {{#candelete}}
                            <a href="{{deleteurl}}" class="btn btn-sm btn-outline-danger" title="{{#str}}eliminar, mod_caracterizacion{{/str}}"
                               onclick="return confirm('{{#str}}confirmareliminar, mod_caracterizacion{{/str}}');">
                                {{#pix}}t/delete, core{{/pix}}
                            </a>
                            {{/candelete}}
                        </div>
                    </td>
                </tr>
                {{/matrices}}
            </tbody>
        </table>
    </div>
    {{/hasmatrices}}

    {{^hasmatrices}}
    <div class="alert alert-info text-center py-4">
        <i class="fa fa-info-circle fa-2x mb-3 d-block"></i>
        <p class="mb-0">{{#str}}nomatrices, mod_caracterizacion{{/str}}</p>
        {{#cancreate}}
        <a href="{{createurl}}" class="btn btn-primary mt-3">
            <i class="fa fa-plus mr-2"></i>{{#str}}crearmatriz, mod_caracterizacion{{/str}}
        </a>
        {{/cancreate}}
    </div>
    {{/hasmatrices}}
</div>
