{{!
    @template mod_caracterizacion/matriz_view

    Template for viewing a characterization matrix with phase progress.

    @package     mod_caracterizacion
    @copyright   2024 Alonso Arias <soporte@orioncloud.com.co>
    @license     http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="mod-caracterizacion-matriz-view" id="matriz-view-{{matrizid}}">

    {{! ===== Header with status ===== }}
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h2 class="mb-1">{{nombre_curso}}</h2>
            <p class="text-muted mb-0">{{programa_academico}}</p>
        </div>
        <div class="text-right">
            <span class="badge badge-pill badge-lg
                {{#is_borrador}}badge-secondary{{/is_borrador}}
                {{#is_en_proceso}}badge-primary{{/is_en_proceso}}
                {{#is_completada}}badge-success{{/is_completada}}"
                style="font-size: 1rem; padding: 0.5rem 1rem;">
                {{#is_borrador}}<i class="fa fa-pencil mr-1"></i>{{/is_borrador}}
                {{#is_en_proceso}}<i class="fa fa-spinner fa-spin mr-1"></i>{{/is_en_proceso}}
                {{#is_completada}}<i class="fa fa-check-circle mr-1"></i>{{/is_completada}}
                {{estado}}
            </span>
            <div class="mt-2">
                <small class="text-muted">{{#str}}faseactual, mod_caracterizacion{{/str}}: <strong>{{fase_actual}}</strong> / 6</small>
            </div>
        </div>
    </div>

    {{! ===== Course Information ===== }}
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fa fa-info-circle mr-2"></i>{{#str}}infodelcurso, mod_caracterizacion{{/str}}</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <strong>{{#str}}programaacademico, mod_caracterizacion{{/str}}:</strong>
                    <p>{{programa_academico}}</p>
                </div>
                <div class="col-md-6">
                    <strong>{{#str}}nombredelcurso, mod_caracterizacion{{/str}}:</strong>
                    <p>{{nombre_curso}}</p>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <strong>{{#str}}creador, mod_caracterizacion{{/str}}:</strong>
                    <p><i class="fa fa-user text-muted mr-1"></i>{{creador}}</p>
                </div>
                <div class="col-md-6">
                    <strong>{{#str}}fechacreacion, mod_caracterizacion{{/str}}:</strong>
                    <p><i class="fa fa-calendar text-muted mr-1"></i>{{fechacreacion}}</p>
                </div>
            </div>
        </div>
    </div>

    {{! ===== Roles ===== }}
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <h4 class="mb-0"><i class="fa fa-users mr-2"></i>{{#str}}asignacionroles, mod_caracterizacion{{/str}}</h4>
        </div>
        <div class="card-body">
            <div class="row">
                {{#roles}}
                <div class="col-md-4 col-sm-6 mb-3">
                    <div class="role-card p-3 h-100" style="background: #f8f9fa; border-radius: 8px; border-left: 4px solid #1a73e8;">
                        <strong class="d-block mb-1" style="font-size: 0.85rem; color: #5f6368;">{{label}}</strong>
                        <span style="font-size: 0.95rem;">
                            {{#userid}}<i class="fa fa-user-circle text-primary mr-1"></i>{{/userid}}
                            {{#nombre}}{{nombre}}{{/nombre}}
                            {{^nombre}}<em class="text-muted">{{#str}}sinasignar, mod_caracterizacion{{/str}}</em>{{/nombre}}
                        </span>
                    </div>
                </div>
                {{/roles}}
            </div>
        </div>
    </div>

    {{! ===== General Resources ===== }}
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0"><i class="fa fa-cube mr-2"></i>{{#str}}recursosgenerales, mod_caracterizacion{{/str}}</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th style="width: 35%;">{{#str}}recurso, mod_caracterizacion{{/str}}</th>
                            <th style="width: 15%;" class="text-center">{{#str}}incluir, mod_caracterizacion{{/str}}</th>
                            <th style="width: 50%;">{{#str}}observaciones, mod_caracterizacion{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#recursos_generales}}
                        <tr>
                            <td><i class="fa fa-file-o text-info mr-2"></i>{{label}}</td>
                            <td class="text-center">
                                {{#incluido}}
                                    <span class="badge badge-success"><i class="fa fa-check mr-1"></i>{{#str}}yes, core{{/str}}</span>
                                {{/incluido}}
                                {{^incluido}}
                                    <span class="badge badge-secondary"><i class="fa fa-times mr-1"></i>{{#str}}no, core{{/str}}</span>
                                {{/incluido}}
                            </td>
                            <td>
                                {{#observaciones}}{{observaciones}}{{/observaciones}}
                                {{^observaciones}}<span class="text-muted">-</span>{{/observaciones}}
                            </td>
                        </tr>
                        {{/recursos_generales}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {{! ===== Units and Topics ===== }}
    {{#hasunidades}}
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="fa fa-book mr-2"></i>{{#str}}unidades, mod_caracterizacion{{/str}}</h4>
        </div>
        <div class="card-body">
            {{#unidades}}
            <div class="card mb-3 shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fa fa-folder-open text-success mr-2"></i>
                        {{#str}}unidadnum, mod_caracterizacion, {{numero}}{{/str}}: {{nombre}}
                    </h5>
                </div>
                <div class="card-body">
                    {{#hastemas}}
                    {{#temas}}
                    <div class="mb-3 pl-3 border-left border-primary">
                        <h6><strong>{{#str}}tema, mod_caracterizacion{{/str}} {{numero}}:</strong> {{nombre}}</h6>
                        {{#hasrecursos}}
                        <table class="table table-sm table-bordered">
                            <thead class="thead-light">
                                <tr>
                                    <th>{{#str}}tiporecurso, mod_caracterizacion{{/str}}</th>
                                    <th>{{#str}}recurso, mod_caracterizacion{{/str}}</th>
                                    <th>{{#str}}item, mod_caracterizacion{{/str}}</th>
                                    <th>{{#str}}observaciones, mod_caracterizacion{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#recursos}}
                                <tr>
                                    <td>{{tipo}}</td>
                                    <td>{{recurso}}</td>
                                    <td>{{item}}</td>
                                    <td>{{#hasobservaciones}}<small>{{observaciones}}</small>{{/hasobservaciones}}</td>
                                </tr>
                                {{/recursos}}
                            </tbody>
                        </table>
                        {{/hasrecursos}}
                    </div>
                    {{/temas}}
                    {{/hastemas}}
                </div>
            </div>
            {{/unidades}}
        </div>
    </div>
    {{/hasunidades}}

    {{! ===== Resource Summary ===== }}
    <div class="card mb-4">
        <div class="card-header bg-warning">
            <h4 class="mb-0"><i class="fa fa-pie-chart mr-2"></i>{{#str}}resumen, mod_caracterizacion{{/str}}</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <tbody>
                        {{#resumen}}
                        <tr{{#istotal}} class="table-active font-weight-bold" style="border-top: 2px solid #f9ab00;"{{/istotal}}>
                            <td>
                                {{#istotal}}<i class="fa fa-calculator mr-2"></i>{{/istotal}}
                                {{^istotal}}<i class="fa fa-circle-o text-muted mr-2"></i>{{/istotal}}
                                {{label}}
                            </td>
                            <td class="text-right">
                                <span class="{{#istotal}}badge badge-warning{{/istotal}}">{{count}}</span>
                            </td>
                        </tr>
                        {{/resumen}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {{! ===== Phase Progress ===== }}
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0"><i class="fa fa-tasks mr-2"></i>{{#str}}progresofases, mod_caracterizacion{{/str}}</h4>
        </div>
        <div class="card-body">
            {{! Phase legend }}
            <div class="d-flex flex-wrap justify-content-center mb-3" style="gap: 1rem;">
                <span class="badge badge-light border"><i class="fa fa-circle text-muted mr-1"></i> {{#str}}pendiente, mod_caracterizacion{{/str}}</span>
                <span class="badge badge-primary"><i class="fa fa-spinner mr-1"></i> {{#str}}en_revision, mod_caracterizacion{{/str}}</span>
                <span class="badge badge-success"><i class="fa fa-check mr-1"></i> {{#str}}aprobada, mod_caracterizacion{{/str}}</span>
                <span class="badge badge-danger"><i class="fa fa-times mr-1"></i> {{#str}}rechazada, mod_caracterizacion{{/str}}</span>
            </div>

            {{! Phase progress bar }}
            <div class="progress mb-4" style="height: 40px;">
                {{#fases}}
                <div class="progress-bar {{#is_aprobada}}bg-success{{/is_aprobada}}{{#is_en_revision}}bg-primary progress-bar-striped progress-bar-animated{{/is_en_revision}}{{#is_rechazada}}bg-danger{{/is_rechazada}}{{#is_pendiente}}bg-light text-dark{{/is_pendiente}}"
                     role="progressbar"
                     style="width: 16.66%"
                     title="{{label}}: {{estado}}"
                     data-toggle="tooltip">
                    <span class="d-flex align-items-center justify-content-center h-100">
                        {{#is_aprobada}}<i class="fa fa-check mr-1"></i>{{/is_aprobada}}
                        {{#is_rechazada}}<i class="fa fa-times mr-1"></i>{{/is_rechazada}}
                        {{fase}}
                    </span>
                </div>
                {{/fases}}
            </div>

            {{! Phase details }}
            <div class="accordion" id="fasesAccordion">
                {{#fases}}
                <div class="card">
                    <div class="card-header {{#is_current}}bg-primary text-white{{/is_current}}" id="faseHead{{fase}}">
                        <h5 class="mb-0">
                            <button class="btn btn-link {{^is_current}}text-dark{{/is_current}} {{#is_current}}text-white{{/is_current}}" type="button"
                                    data-toggle="collapse" data-target="#faseBody{{fase}}"
                                    aria-expanded="{{#is_current}}true{{/is_current}}{{^is_current}}false{{/is_current}}">
                                {{label}}
                                <span class="badge ml-2
                                    {{#is_aprobada}}badge-success{{/is_aprobada}}
                                    {{#is_en_revision}}badge-primary{{/is_en_revision}}
                                    {{#is_rechazada}}badge-danger{{/is_rechazada}}
                                    {{#is_pendiente}}badge-secondary{{/is_pendiente}}">
                                    {{estado}}
                                </span>
                            </button>
                        </h5>
                    </div>
                    <div id="faseBody{{fase}}" class="collapse {{#is_current}}show{{/is_current}}" data-parent="#fasesAccordion">
                        <div class="card-body">
                            {{! Action buttons for current phase }}
                            {{#is_current}}
                            {{#is_en_revision}}
                            <div class="fase-actions mb-3" id="fase-actions-{{fase}}">
                                <div class="form-group">
                                    <label for="comentario-fase-{{fase}}">{{#str}}comentarios, mod_caracterizacion{{/str}}</label>
                                    <textarea class="form-control fase-comentario" id="comentario-fase-{{fase}}" rows="3"
                                              data-faseid="{{faseid}}" data-fase="{{fase}}"></textarea>
                                </div>
                                {{! Approvers can approve or reject }}
                                {{#canapprove}}
                                <button class="btn btn-success btn-fase-action mr-2"
                                        data-action="aprobar" data-faseid="{{faseid}}"
                                        data-matrizid="{{matrizid}}" data-cmid="{{cmid}}">
                                    {{#pix}}i/valid, core{{/pix}} {{#str}}aprobar, mod_caracterizacion{{/str}}
                                </button>
                                <button class="btn btn-danger btn-fase-action mr-2"
                                        data-action="rechazar" data-faseid="{{faseid}}"
                                        data-matrizid="{{matrizid}}" data-cmid="{{cmid}}">
                                    {{#pix}}i/invalid, core{{/pix}} {{#str}}rechazar, mod_caracterizacion{{/str}}
                                </button>
                                {{/canapprove}}
                                {{! Actors (non-approvers) can only comment }}
                                {{#canact}}
                                {{^canapprove}}
                                <button class="btn btn-primary btn-fase-action mr-2"
                                        data-action="comentar" data-faseid="{{faseid}}"
                                        data-matrizid="{{matrizid}}" data-cmid="{{cmid}}">
                                    {{#pix}}i/comment, core{{/pix}} {{#str}}comentar, mod_caracterizacion{{/str}}
                                </button>
                                {{/canapprove}}
                                {{/canact}}
                            </div>
                            {{/is_en_revision}}
                            {{! Resubmit button for rejected phases }}
                            {{#is_rechazada}}
                            {{#canact}}
                            <div class="fase-actions mb-3" id="fase-reenviar-{{fase}}">
                                <div class="form-group">
                                    <label for="comentario-reenvio-{{fase}}">{{#str}}comentarios, mod_caracterizacion{{/str}}</label>
                                    <textarea class="form-control fase-comentario" id="comentario-reenvio-{{fase}}" rows="3"
                                              data-faseid="{{faseid}}" data-fase="{{fase}}"></textarea>
                                </div>
                                <button class="btn btn-warning btn-fase-action"
                                        data-action="reenviar" data-faseid="{{faseid}}"
                                        data-matrizid="{{matrizid}}" data-cmid="{{cmid}}">
                                    {{#pix}}i/reload, core{{/pix}} {{#str}}reenviar, mod_caracterizacion{{/str}}
                                </button>
                            </div>
                            {{/canact}}
                            {{/is_rechazada}}
                            {{/is_current}}

                            {{! Comments list }}
                            <h6>{{#str}}comentarios, mod_caracterizacion{{/str}}</h6>
                            {{#hascomentarios}}
                            <div class="list-group">
                                {{#comentarios}}
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <strong>{{usuario}}</strong>
                                        <small class="text-muted">{{fecha}}</small>
                                    </div>
                                    <p class="mb-1">{{comentario}}</p>
                                    <small class="badge
                                        {{#accion}}
                                        badge-info
                                        {{/accion}}">
                                        {{accion}}
                                    </small>
                                </div>
                                {{/comentarios}}
                            </div>
                            {{/hascomentarios}}
                            {{^hascomentarios}}
                            <p class="text-muted">{{#str}}sincomentarios, mod_caracterizacion{{/str}}</p>
                            {{/hascomentarios}}
                        </div>
                    </div>
                </div>
                {{/fases}}
            </div>
        </div>
    </div>
</div>
