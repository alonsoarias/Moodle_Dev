{{!
    This file is part of Moodle - http://moodle.org/

    Windows Explorer inspired template for the folder module.
    @template mod_folder/folder
    @package   mod_folder
}}

<div class="folder-explorer folder-explorer-windows" id="{{id}}" data-root-name="{{rootname}}">

    {{! Intro }}
    {{#intro}}
    <div class="folder-intro">
        {{{intro}}}
    </div>
    {{/intro}}

    {{! Buttons }}
    {{#hasbuttons}}
    <div class="folder-header-actions">
        <div class="btn-group">
            {{#edit_button}}
                {{>core/single_button}}
            {{/edit_button}}
            {{#download_button}}
                {{>core/single_button}}
            {{/download_button}}
        </div>
    </div>
    {{/hasbuttons}}

    <div class="explorer-window" role="region" aria-label="{{strings.explorercontents}}">
        <header class="explorer-command-bar">
            <div class="command-navigation">
                <div class="navigation-buttons" role="group" aria-label="{{strings.navigationcontrols}}">
                    <button type="button" class="nav-button nav-button-back" title="{{strings.navbacktitle}}" aria-label="{{strings.navbackaria}}" disabled>
                        <span class="icon" aria-hidden="true"><i class="fa fa-arrow-left"></i></span>
                    </button>
                    <button type="button" class="nav-button nav-button-forward" title="{{strings.navforwardtitle}}" aria-label="{{strings.navforwardaria}}" disabled>
                        <span class="icon" aria-hidden="true"><i class="fa fa-arrow-right"></i></span>
                    </button>
                    <button type="button" class="nav-button nav-button-up" title="{{strings.navuptitle}}" aria-label="{{strings.navuparia}}" disabled>
                        <span class="icon" aria-hidden="true"><i class="fa fa-arrow-up"></i></span>
                    </button>
                </div>
                <div class="breadcrumb-wrapper" role="navigation" aria-label="{{strings.folderbreadcrumbs}}">
                    <div class="folder-breadcrumbs"></div>
                </div>
            </div>
            <div class="command-search">
                <div class="search-box">
                    <span class="search-icon" aria-hidden="true"><i class="fa fa-search"></i></span>
                    <input type="text"
                           class="folder-search-input"
                           placeholder="{{strings.searchplaceholder}}"
                           aria-label="{{strings.searcharia}}">
                    <button type="button" class="search-clear" aria-label="{{strings.clearsearch}}" hidden>
                        <i class="fa fa-times"></i>
                    </button>
                </div>
            </div>
        </header>

        <div class="explorer-viewbar">
            <div class="viewbar-left">
                <div class="window-title" aria-live="polite">
                    <span class="title-label">{{strings.explorertitle}}</span>
                    <span class="title-separator" aria-hidden="true">/</span>
                    <span class="title-value">{{rootname}}</span>
                </div>
            </div>
            <div class="viewbar-right">
                <div class="view-controls" role="group" aria-label="{{strings.viewdetails}}">
                    <button class="view-toggle active" data-view="grid" title="{{strings.viewgrid}}">
                        <i class="fa fa-th-large" aria-hidden="true"></i>
                        <span class="sr-only">{{strings.viewgrid}}</span>
                    </button>
                    <button class="view-toggle" data-view="list" title="{{strings.viewlist}}">
                        <i class="fa fa-list" aria-hidden="true"></i>
                        <span class="sr-only">{{strings.viewlist}}</span>
                    </button>
                    <button class="view-toggle" data-view="details" title="{{strings.viewdetails}}">
                        <i class="fa fa-th-list" aria-hidden="true"></i>
                        <span class="sr-only">{{strings.viewdetails}}</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="explorer-body">
            {{#has_tree}}
            <aside class="folder-navigation" aria-label="{{strings.navigationaria}}">
                <div class="navigation-title">{{strings.explorertree}}</div>
                <div class="folder-tree-scroll">
                    <ul class="folder-tree-list">
                        {{#tree}}
                            {{> mod_folder/tree}}
                        {{/tree}}
                    </ul>
                </div>
            </aside>
            {{/has_tree}}

            <section class="folder-main-panel">
                <div class="folder-views">
                    <div class="folder-view folder-view-grid active">
                        <div class="grid-container">
                            {{#items}}
                            <div class="grid-item {{#is_folder}}item-folder{{/is_folder}}{{#is_file}}item-file{{/is_file}}"
                                 data-name="{{name}}"
                                 data-type="{{type}}"
                                 data-extension="{{extension}}"
                                 data-size-bytes="{{size_bytes}}"
                                 data-modified-timestamp="{{modified_timestamp}}"
                                 data-file-category="{{file_category}}"
                                 data-parent-path="{{parent_path_encoded}}"
                                 {{#folder_path_encoded}}data-folder-path="{{folder_path_encoded}}"{{/folder_path_encoded}}
                                 {{#url}}data-url="{{{url}}}"{{/url}}>
                                <div class="item-surface">
                                    <div class="item-icon {{icon_class}}">
                                        {{{icon}}}
                                    </div>
                                    <div class="item-text">
                                        <div class="item-name" title="{{name}}">{{name}}</div>
                                        {{#is_file}}
                                        <div class="item-meta">
                                            <span class="item-size">{{size}}</span>
                                            <span class="item-modified">{{modified}}</span>
                                        </div>
                                        {{/is_file}}
                                    </div>
                                </div>
                            </div>
                            {{/items}}
                        </div>
                    </div>

                    <div class="folder-view folder-view-list">
                        <table class="folder-table folder-table-list">
                            <thead>
                                <tr>
                                    <th>{{strings.tableheadername}}</th>
                                    <th>{{strings.tableheadertype}}</th>
                                    <th>{{strings.tableheadersize}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#items}}
                                <tr class="list-item"
                                    data-name="{{name}}"
                                    data-type="{{type}}"
                                    data-extension="{{extension}}"
                                    data-size-bytes="{{size_bytes}}"
                                    data-modified-timestamp="{{modified_timestamp}}"
                                    data-file-category="{{file_category}}"
                                    data-parent-path="{{parent_path_encoded}}"
                                    {{#folder_path_encoded}}data-folder-path="{{folder_path_encoded}}"{{/folder_path_encoded}}
                                    {{#url}}data-url="{{{url}}}"{{/url}}>
                                    <td>
                                        <span class="list-icon {{icon_class}}">{{{icon}}}</span>
                                        <span class="list-name">{{name}}</span>
                                    </td>
                                    <td>{{type}}</td>
                                    <td>{{size}}</td>
                                </tr>
                                {{/items}}
                            </tbody>
                        </table>
                    </div>

                    <div class="folder-view folder-view-details">
                        <table class="folder-table folder-table-details">
                            <thead>
                                <tr>
                                    <th>{{strings.tableheadername}}</th>
                                    <th>{{strings.tableheaderdatemodified}}</th>
                                    <th>{{strings.tableheadertype}}</th>
                                    <th>{{strings.tableheadersize}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#items}}
                                <tr class="details-item"
                                    data-name="{{name}}"
                                    data-type="{{type}}"
                                    data-extension="{{extension}}"
                                    data-size-bytes="{{size_bytes}}"
                                    data-modified-timestamp="{{modified_timestamp}}"
                                    data-file-category="{{file_category}}"
                                    data-parent-path="{{parent_path_encoded}}"
                                    {{#folder_path_encoded}}data-folder-path="{{folder_path_encoded}}"{{/folder_path_encoded}}
                                    {{#url}}data-url="{{{url}}}"{{/url}}>
                                    <td>
                                        <span class="details-icon {{icon_class}}">{{{icon}}}</span>
                                        <span class="details-name">{{name}}</span>
                                    </td>
                                    <td class="text-muted">{{modified}}</td>
                                    <td class="text-muted">{{type}}</td>
                                    <td class="text-muted">{{size}}</td>
                                </tr>
                                {{/items}}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="empty-folder-message" hidden>
                    <div class="empty-state">
                        <i class="fa fa-folder-open-o" aria-hidden="true"></i>
                        <p>{{strings.emptyfolder}}</p>
                    </div>
                </div>

                <div class="no-results-message" hidden>
                    <div class="empty-state">
                        <i class="fa fa-search" aria-hidden="true"></i>
                        <p>{{strings.noresults}}</p>
                        <button class="btn btn-secondary clear-search-btn" type="button">{{strings.clearsearch}}</button>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
