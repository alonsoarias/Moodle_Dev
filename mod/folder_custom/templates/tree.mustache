{{!
    This file is part of Moodle - http://moodle.org/

    Tree template for Windows Explorer style navigation
    @template mod_folder_custom/tree
    @package   mod_folder_custom
}}

<li class="folder_custom-tree-node {{#isroot}}is-root{{/isroot}} {{#hassubdirs}}has-children{{/hassubdirs}} {{#expanded}}expanded{{/expanded}}{{^expanded}}collapsed{{/expanded}}"
    data-path="{{path_encoded}}">
    <div class="folder_custom-tree-node-inner">
        {{#hassubdirs}}
        <button type="button" class="folder_custom-tree-toggle" aria-label="{{strings.togglefolder_custom}}" aria-expanded="{{#expanded}}true{{/expanded}}{{^expanded}}false{{/expanded}}"></button>
        {{/hassubdirs}}
        {{^hassubdirs}}
        <span class="folder_custom-tree-toggle placeholder" aria-hidden="true"></span>
        {{/hassubdirs}}
        <span class="folder_custom-tree-icon">{{{icon}}}</span>
        <button type="button" class="folder_custom-tree-label">{{name}}</button>
    </div>
    {{#hassubdirs}}
    <ul class="folder_custom-tree-children">
        {{#subdirs}}
            {{> mod_folder_custom/tree}}
        {{/subdirs}}
    </ul>
    {{/hassubdirs}}
</li>
