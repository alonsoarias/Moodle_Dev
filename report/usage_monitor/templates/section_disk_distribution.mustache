{{!
    @template report_usage_monitor/section_disk_distribution

    Disk distribution chart section.

    Context variables required:
    * disk_distribution.title - Section title
    * disk_distribution.has_data - Whether there is data to display
    * disk_distribution.no_data_message - Message when no data
}}
<div class="col-md-6 mb-4">
    <div class="card shadow-sm h-100">
        <div class="card-header">
            <h5 class="mb-0">{{disk_distribution.title}}</h5>
        </div>
        <div class="card-body" style="position:relative; min-height:400px;">
            {{#disk_distribution.has_data}}
                <canvas id="chartjs-doughnut"></canvas>
            {{/disk_distribution.has_data}}
            {{^disk_distribution.has_data}}
                <div class="alert alert-info">
                    {{disk_distribution.no_data_message}}
                </div>
            {{/disk_distribution.has_data}}
        </div>
    </div>
</div>
