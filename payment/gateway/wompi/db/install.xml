<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="payment/gateway/wompi/db" VERSION="20241216" COMMENT="XMLDB file for Wompi payment gateway plugin"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="paygw_wompi_transactions" COMMENT="Stores Wompi transaction information">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle user ID"/>
        <FIELD NAME="transactionid" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="Wompi transaction ID"/>
        <FIELD NAME="reference" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Unique transaction reference"/>
        <FIELD NAME="component" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Payment component"/>
        <FIELD NAME="paymentarea" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="Payment area"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Item ID"/>
        <FIELD NAME="amount" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Amount in cents"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="COP" SEQUENCE="false" COMMENT="Currency code"/>
        <FIELD NAME="status" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="PENDING" SEQUENCE="false" COMMENT="Transaction status"/>
        <FIELD NAME="paymentmethod" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Payment method used"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time created"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time modified"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="transactionid" UNIQUE="true" FIELDS="transactionid"/>
        <INDEX NAME="reference" UNIQUE="true" FIELDS="reference"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
