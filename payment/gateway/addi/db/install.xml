<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="payment/gateway/addi/db" VERSION="20250101" COMMENT="XMLDB file for Addi payment gateway"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="paygw_addi_transactions" COMMENT="Stores Addi transaction data">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User ID"/>
        <FIELD NAME="component" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Payment component"/>
        <FIELD NAME="paymentarea" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="Payment area"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Item ID"/>
        <FIELD NAME="paymentid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Payment record ID"/>
        <FIELD NAME="reference" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Internal reference"/>
        <FIELD NAME="applicationid" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="Addi application ID"/>
        <FIELD NAME="amount" TYPE="number" LENGTH="15" NOTNULL="true" DECIMALS="2" SEQUENCE="false" COMMENT="Transaction amount"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" DEFAULT="COP" SEQUENCE="false" COMMENT="Currency code"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="PENDING" SEQUENCE="false" COMMENT="Transaction status"/>
        <FIELD NAME="response" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON response from Addi"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time created"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time modified"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="reference" UNIQUE="true" FIELDS="reference"/>
        <INDEX NAME="applicationid" UNIQUE="false" FIELDS="applicationid"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="component_paymentarea_itemid" UNIQUE="false" FIELDS="component, paymentarea, itemid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
