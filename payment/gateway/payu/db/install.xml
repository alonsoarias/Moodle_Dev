<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="payment/gateway/payu/db" VERSION="20251216" COMMENT="XMLDB file for PayU Colombia payment gateway"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="paygw_payu_transactions" COMMENT="Stores PayU Colombia transaction information">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle user ID"/>
        <FIELD NAME="transactionid" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="PayU transaction ID"/>
        <FIELD NAME="referencecode" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Unique transaction reference"/>
        <FIELD NAME="orderid" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="PayU order ID (reference_pol)"/>
        <FIELD NAME="component" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Payment component"/>
        <FIELD NAME="paymentarea" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="Payment area"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Item ID"/>
        <FIELD NAME="amount" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" SEQUENCE="false" COMMENT="Amount"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="COP" SEQUENCE="false" COMMENT="Currency code"/>
        <FIELD NAME="state" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="PENDING" SEQUENCE="false" COMMENT="Transaction state"/>
        <FIELD NAME="paymentmethod" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Payment method used"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time created"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time modified"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="referencecode" UNIQUE="true" FIELDS="referencecode"/>
        <INDEX NAME="transactionid" UNIQUE="false" FIELDS="transactionid"/>
        <INDEX NAME="state" UNIQUE="false" FIELDS="state"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
