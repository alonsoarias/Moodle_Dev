{{!
    @template theme_inteb/format_remuiformat/optional_secheader

    This template renders the optional section header for format_remuiformat with ALL teachers.

    Modificaciones respecto a format_remuiformat:
    - Muestra TODOS los profesores (editing y non-editing teachers)
    - Agrega badges con conteos por tipo
    - Agrega indicadores visuales en avatares
    - Agrega clases CSS para diferenciar tipos de profesores
}}

<div class="rmuiformate-header-wrapper d-none ">
    <header id="page-header" class=" d-print-none hasbackground design-1 position-relative "
        style="background:  url('{{headercourseimage}}');background-position: {{remuiheaderimagebgposition}}; background-size:{{remuiheaderimagebgsize}};background-repeat: no-repeat;">
           <div class = "position-absolute w-100 h-100" style="background: linear-gradient(180deg, rgba(0, 0, 0, 0.0)  -24.52%, #000000 97.67%);left:0%;bottom:0%; opacity:{{{overlayopacity}}};border-radius:inherit;"> </div>
       <div class="align-self-end" style="z-index:1;">
        {{{turneditingonswitch}}}
       </div>
        <div class="w-100 header-wrapper " style="z-index:1;">
            <div class="d-flex flex-wrap w-100">
                <div class="d-flex align-items-center w-100">
                    <div class="dashboard-bar-wrapper w-100">
                        <div class="header-main-section">
                            <div class="category">
                                <span class="badge ">
                                    {{{coursecategoryname}}}
                                </span>
                            </div>
                            <div class="page-context-header p-0 m-0">
                                <div class="page-header-headings p-0">
                                    <h1 class="h2 header-heading coursepage design-1 m-0">{{{coursefullname}}}</h1>
                                </div>
                            </div>
                        </div>
                        <div class="header-sub-section">
                            <div class="rating-instructor-wrapper">
                                {{#rnrdesign}}
                                <div class="edw-ratings-wrapper">
                                    {{{rnrdesign}}}
                                </div>
                                {{/rnrdesign}}

                                {{!
                                    ===============================================================
                                    SECCIÓN MODIFICADA: Profesores con indicadores de tipo
                                    ===============================================================
                                }}
                                {{#teachers}}
                                <div class="instructor-info stat-container position-relative">
                                    {{! Badges con conteos por tipo }}
                                    {{#total_teachers_count}}
                                        <div class="instructors-header-label mb-2" title="Total: {{total_teachers_count}} profesores">
                                            {{#editing_teachers_count}}
                                                <span class="badge badge-primary editing-teacher-badge" title="{{#str}}editingteachers,theme_inteb{{/str}}">
                                                    <i class="fa fa-edit"></i> {{editing_teachers_count}}
                                                </span>
                                            {{/editing_teachers_count}}
                                            {{#non_editing_teachers_count}}
                                                <span class="badge badge-secondary non-editing-teacher-badge" title="{{#str}}noneditingteachers,theme_inteb{{/str}}">
                                                    <i class="fa fa-user"></i> {{non_editing_teachers_count}}
                                                </span>
                                            {{/non_editing_teachers_count}}
                                        </div>
                                    {{/total_teachers_count}}

                                    {{! Lista de profesores con indicadores }}
                                    <div class="instructors-list-wrapper d-flex flex-wrap">
                                        {{#instructors}}
                                            <div class="position-relative instructor-item {{teacher_type_class}}" title="{{teacher_type_title}}: {{name}}">
                                                <a class="view-user-profile-link" href="{{teacherprofileurl}}" title="{{name}}"></a>
                                                <div class="instructor-avatar-wrapper">
                                                    {{{avatars}}}
                                                    {{! Indicador visual del tipo de profesor }}
                                                    <span class="teacher-type-indicator {{teacher_type_class}}-indicator">
                                                        {{#is_editing_teacher}}
                                                            <i class="fa fa-pencil" aria-hidden="true"></i>
                                                        {{/is_editing_teacher}}
                                                        {{^is_editing_teacher}}
                                                            <i class="fa fa-user-o" aria-hidden="true"></i>
                                                        {{/is_editing_teacher}}
                                                    </span>
                                                </div>
                                                <span class="titles instructor-name-label">{{name}}</span>
                                            </div>
                                        {{/instructors}}
                                    </div>

                                    {{! Enlace "View all" solo si teachercount > 0 (actualmente siempre 0 porque mostramos todos) }}
                                    {{#teachercount}}
                                        <a class="view-all-instructorslink" href="{{participantspageurl}}">view all (+{{teachercount}})</a>
                                    {{/teachercount}}
                                </div>
                                {{/teachers}}
                                {{!
                                    ===============================================================
                                    FIN DE SECCIÓN MODIFICADA
                                    ===============================================================
                                }}
                            </div>
                            {{#coursecompletionstatus}}
                            <div class="progress-resume-wrapper">
                                <div class="progressbar-text-wrapper">
                                    <div class="progress progress-rounded">
                                        <div class="progress-bar bg-green-600"
                                            style="width: {{{percentage}}}%; height: 100%;" role="progressbar">
                                            <span class="sr-only">{{{percentage}}}% {{#str}} Complete, format_remuiformat {{/str}}</span>
                                        </div>
                                    </div>
                                    <span>{{{percentage}}}% {{#str}} Complete, format_remuiformat {{/str}}</span>
                                </div>
                                {{#resumeactivityurl}}
                                <a class="btn btn-primary bold" href="{{{ resumeactivityurl }}}"
                                    role="button">{{#str}} resumetoactivity, format_remuiformat{{/str}}</a>
                                {{/resumeactivityurl}}
                            </div>
                            {{/coursecompletionstatus}}
                        </div>
                    </div>
                </div>
            </div>
    </header>
</div>
{{#courseheaderdesign}}
{{#js}}
require(['format_remuiformat/headerreplaces'], function(HEADERREPLACE) {
HEADERREPLACE.init();
});
{{/js}}
{{/courseheaderdesign}}
{{#subsectionjs}}
{{#js}}
require(['jquery','core_courseformat/local/content'], function($,component) {
    $(document).ready(function() {
      component.init('page', {}, {{sectionreturn}});
    });
});
{{/js}}
{{/subsectionjs}}
