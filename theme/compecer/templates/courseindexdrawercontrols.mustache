{{!
    Course index drawer controls for theme Compecer.
}}
<div id="courseindexdrawercontrols" class="course-index-controls dropdown">
  <button
    class="btn btn-icon btn-outline-secondary rounded-circle"
    type="button"
    data-toggle="dropdown"
    aria-haspopup="true"
    aria-expanded="false"
    title="{{#str}}courseindexoptions, theme_compecer{{/str}}"
  >
    <i class="icon fa fa-ellipsis-v" aria-hidden="true"></i>
    <span class="sr-only">{{#str}}courseindexoptions, theme_compecer{{/str}}</span>
  </button>
  <div class="dropdown-menu dropdown-menu-right">
    <a class="dropdown-item" href="#" data-action="expandallcourseindexsections">
      {{#pix}} t/angles-down, core {{/pix}}
      {{#str}}expandall{{/str}}
    </a>
    <a class="dropdown-item" href="#" data-action="collapseallcourseindexsections">
      <span class="dir-rtl-hide">{{#pix}} t/angles-right, core {{/pix}}</span>
      <span class="dir-ltr-hide">{{#pix}} t/angles-left, core {{/pix}}</span>
      {{#str}}collapseall{{/str}}
    </a>
  </div>
</div>
{{#js}}
require(['theme_compecer/courseindexdrawercontrols'], function(component) {
  component.init('courseindexdrawercontrols');
});
{{/js}}
