{{!
    @template core_courseformat/local/courseindex/cm

    Displays a course index module entry with completion state icon.
    Adaptado para theme compecer con indicadores de estado de completado.

    Example context (json):
    {
      "id": "12",
      "name": "Announcements",
      "url": "#",
      "visible": 1,
      "isactive": 1,
      "uservisible": 1,
      "uniqid": "0",
      "hascmrestrictions": 0,
      "completionstate": "completed",
      "completionicon": "✓",
      "completioncolor": "text-success",
      "completionlabel": "Completada"
    }
}}
<li class="course-index-item {{#isactive}}active{{/isactive}}
           {{#hascmrestrictions}}restrictions{{/hascmrestrictions}}
           {{^uservisible}}dimmed{{/uservisible}}
           {{#indent}} indented {{/indent}}
           {{#completionstate}}completion-{{completionstate}}{{/completionstate}}"
    id="{{uniqid}}-course-index-cm-{{id}}"
    data-for="cm"
    data-id="{{id}}"
    role="treeitem">
  {{^hasdelegatedsection}}
    <div class="activity-item-content">

      {{! Completion state icon }}
      {{#completionicon}}
      <span class="activity-completion-icon {{completioncolor}}"
            aria-label="{{completionlabel}}"
            title="{{completionlabel}}">
        {{completionicon}}
      </span>
      {{/completionicon}}

      {{! Activity link }}
      {{#uservisible}}
        <a class="course-index-link activity-link text-truncate"
           {{#url}}href="{{{url}}}"{{/url}}
           {{^url}}href="#cm{{id}}" data-anchor="true"{{/url}}
           data-for="cm_name"
           tabindex="-1"
           title="{{{name}}}">
          {{{name}}}
        </a>
      {{/uservisible}}

      {{! Activity not visible to user }}
      {{^uservisible}}
        <span class="activity-link-disabled text-truncate" title="{{{name}}}">
          {{{name}}}
        </span>
      {{/uservisible}}

    </div>
  {{/hasdelegatedsection}}

  {{! Delegated section (special case) }}
  {{#hasdelegatedsection}}
    {{#sectioninfo}}
      {{> core_courseformat/local/courseindex/section}}
    {{/sectioninfo}}
  {{/hasdelegatedsection}}
</li>
{{#js}}
require(['core_courseformat/local/courseindex/cm'], function(component) {
  component.init('{{uniqid}}-course-index-cm-{{id}}');
});
{{/js}}
