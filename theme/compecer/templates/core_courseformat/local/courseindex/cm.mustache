{{!
    @template core_courseformat/local/courseindex/cm

    Course Index Activity Module - Redesigned for Theme Compecer

    Features:
    - Clean, professional activity design
    - Traffic light completion indicators:
      * Green: Completed
      * Yellow: In Progress
      * Red: Pending
      * Gray: Not Available
    - Sober, minimal styling inspired by Theme Remui
    - No activity icons (clean design)

    Context variables:
    {
        "id": "12",
        "name": "Announcements",
        "url": "#",
        "visible": 1,
        "isactive": 1,
        "uniqid": "0",
        "accessvisible": 1,
        "hascmrestrictions": 0,
        "uservisible": 1,
        "hasdelegatedsection": 0,
        "activitystate": "completed",
        "hasactivitystate": true,
        "isstatecompleted": true,
        "isstateinprogress": false,
        "isstatepending": false,
        "isstatenotavailable": false
    }
}}
<li class="courseindex-item {{#isactive}}active{{/isactive}} {{#pageitem}}pageitem{{/pageitem}} {{#hascmrestrictions}}restrictions{{/hascmrestrictions}} {{^accessvisible}}dimmed{{/accessvisible}} {{#indent}}indented{{/indent}}"
    id="{{uniqid}}-courseindex-cm-{{id}}"
    data-for="cm"
    data-id="{{id}}"
    role="treeitem">

    {{^hasdelegatedsection}}
    <div class="d-flex align-items-center">
        {{! Traffic Light Indicator }}
        {{#hasactivitystate}}
        <span class="activity-state-indicator mr-2 {{#isstatecompleted}}state-completed{{/isstatecompleted}}{{#isstateinprogress}}state-inprogress{{/isstateinprogress}}{{#isstatepending}}state-pending{{/isstatepending}}{{#isstatenotavailable}}state-notavailable{{/isstatenotavailable}}"
              aria-label="{{#isstatecompleted}}{{#str}}activity_completed, theme_compecer{{/str}}{{/isstatecompleted}}{{#isstateinprogress}}{{#str}}activity_inprogress, theme_compecer{{/str}}{{/isstateinprogress}}{{#isstatepending}}{{#str}}activity_pending, theme_compecer{{/str}}{{/isstatepending}}{{#isstatenotavailable}}{{#str}}activity_notavailable, theme_compecer{{/str}}{{/isstatenotavailable}}"
              title="{{#isstatecompleted}}{{#str}}activity_completed, theme_compecer{{/str}}{{/isstatecompleted}}{{#isstateinprogress}}{{#str}}activity_inprogress, theme_compecer{{/str}}{{/isstateinprogress}}{{#isstatepending}}{{#str}}activity_pending, theme_compecer{{/str}}{{/isstatepending}}{{#isstatenotavailable}}{{#str}}activity_notavailable, theme_compecer{{/str}}{{/isstatenotavailable}}">
        </span>
        {{/hasactivitystate}}

        {{! Activity Link }}
        {{#uservisible}}
        <a class="courseindex-link text-truncate flex-grow-1"
           {{#url}}href="{{{url}}}"{{/url}}
           {{^url}}href="#{{{anchor}}}" data-anchor="true"{{/url}}
           data-for="cm_name"
           tabindex="-1"
           title="{{{name}}}">
            {{{name}}}
        </a>
        {{/uservisible}}

        {{^uservisible}}
        <a class="courseindex-link text-truncate flex-grow-1 dimmed"
           href="#{{{anchor}}}"
           data-for="cm_name"
           tabindex="-1"
           data-anchor="true"
           title="{{{name}}}">
            {{{name}}}
        </a>
        {{/uservisible}}

        {{! Completion Info (from core) }}
        {{#completioninfo}}
        <span class="completioninfo {{classes}}"
              data-for="cm_completion"
              data-value="{{completionstate}}">
        </span>
        {{/completioninfo}}
    </div>
    {{/hasdelegatedsection}}

    {{#hasdelegatedsection}}
    {{#sectioninfo}}
        {{> core_courseformat/local/courseindex/section}}
    {{/sectioninfo}}
    {{/hasdelegatedsection}}
</li>

{{#js}}
require(['core_courseformat/local/courseindex/cm'], function(component) {
    component.init('{{uniqid}}-courseindex-cm-{{id}}');
});
{{/js}}
