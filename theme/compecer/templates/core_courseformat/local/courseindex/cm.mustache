{{!
    @template core_courseformat/local/courseindex/cm

    Displays a course index module entry.
    Adaptado para theme compecer.
    Se han eliminado los iconos de las actividades.
    
    Example context (json):
    {
      "id": "12",
      "name": "Announcements",
      "url": "#",
      "visible": 1,
      "isactive": 1,
      "uniqid": "0",
      "accessvisible": 1,
      "hascmrestrictions": 0
    }
}}
<li class="courseindex-item
        {{#isactive}}active{{/isactive}}
        {{#hascmrestrictions}}restrictions{{/hascmrestrictions}}
        {{^accessvisible}}dimmed{{/accessvisible}}
        {{#indent}} indented {{/indent}}
        {{#hasdelegatedsection}}py-0{{/hasdelegatedsection}}"
    id="{{uniqid}}-courseindex-cm-{{id}}"
    data-for="cm"
    data-id="{{id}}"
    role="treeitem">
    {{^hasdelegatedsection}}
        <div class="compecer-courseindex-cm d-flex align-items-center">
            <span class="compecer-courseindex-cm__status">
                <span class="completioninfo" data-for="cm_completion" data-value="NaN"></span>
            </span>
            <div class="compecer-courseindex-cm__content flex-grow-1">
                {{#uservisible}}
                    <a class="courseindex-link text-truncate"
                       {{#url}}href="{{{url}}}"{{/url}}
                       {{^url}}href="#{{{anchor}}}" data-anchor="true"{{/url}}
                       data-for="cm_name" tabindex="-1" title="{{{name}}}">
                        {{{name}}}
                    </a>
                {{/uservisible}}
                {{^uservisible}}
                    <a class="courseindex-link text-truncate"
                       href="#{{{anchor}}}" data-for="cm_name" tabindex="-1" data-anchor="true">
                        {{{name}}}
                    </a>
                {{/uservisible}}
            </div>
            <div class="compecer-courseindex-cm__actions">
                <span class="courseindex-locked" data-for="cm_name">
                    {{#pix}} t/locked, core {{/pix}}
                </span>
                <span class="dragicon">{{#pix}} i/dragdrop, core {{/pix}}</span>
            </div>
        </div>
    {{/hasdelegatedsection}}
    {{#hasdelegatedsection}}
        {{#sectioninfo}}
            {{> core_courseformat/local/courseindex/section}}
        {{/sectioninfo}}
    {{/hasdelegatedsection}}
</li>
{{#js}}
require(['core_courseformat/local/courseindex/cm'], function(component) {
    component.init('{{uniqid}}-courseindex-cm-{{id}}');
});
{{/js}}
