{{!
    @template core_courseformat/local/courseindex/cm

    Course index module entry inspired by RemUI implementation.
}}
<li class="courseindex-item
        {{#isactive}}active{{/isactive}}
        {{#hascmrestrictions}}restrictions{{/hascmrestrictions}}
        {{^accessvisible}}dimmed{{/accessvisible}}
        {{#indent}} indented {{/indent}}
        {{#hasdelegatedsection}}py-0{{/hasdelegatedsection}}"
    id="{{uniqid}}-course-index-cm-{{id}}"
    data-for="cm"
    data-id="{{id}}"
    role="treeitem"
>
    {{^hasdelegatedsection}}
        <div class="courseindex-item__main">
            <span class="completioninfo" data-for="cm_completion" data-value="NaN"></span>
            <span class="courseindex-item__status" aria-hidden="true"></span>
            {{#uservisible}}
            <a
                class="courseindex-item__link text-truncate"
                {{#url}} href="{{{url}}}" {{/url}}{{^url}} href="#{{{anchor}}}" data-anchor="true" {{/url}}
                data-for="cm_name"
                tabindex="-1"
            >
                <span class="courseindex-item__name text-truncate">{{{name}}}</span>
            </a>
            {{/uservisible}}
            {{^uservisible}}
            <a class="courseindex-item__link text-truncate"
                href="#{{{anchor}}}"
                data-for="cm_name"
                tabindex="-1"
                data-anchor="true"
            >
                <span class="courseindex-item__name text-truncate">{{{name}}}</span>
            </a>
            {{/uservisible}}
            <span class="courseindex-item__status-text sr-only" data-region="cm-status-text"></span>
        </div>
        <div class="courseindex-item__meta">
            <span class="courseindex-locked" data-for="cm_restrictions">
                {{#pix}} t/locked, core {{/pix}}
            </span>
            <span class="dragicon">
                <i class="fa fa-grip-vertical" aria-hidden="true"></i>
                <span class="sr-only">{{#str}} move, core {{/str}}</span>
            </span>
        </div>
    {{/hasdelegatedsection}}
    {{#hasdelegatedsection}}
        {{#sectioninfo}}
            {{> core_courseformat/local/courseindex/section}}
        {{/sectioninfo}}
    {{/hasdelegatedsection}}
</li>

{{#js}}
require(['core_courseformat/local/courseindex/cm'], function(component) {
    component.init('{{uniqid}}-course-index-cm-{{id}}');
});
{{/js}}
