{{!
    @template core_courseformat/local/courseindex/courseindex

    Redesigned course index for theme compecer. Adds a dedicated
    progress summary panel and refreshed section/module layout.
}}
<div class="compecer-courseindex-panel {{#editmode}}editing{{/editmode}}">
    <div class="compecer-courseindex-panel__header">
        <div class="compecer-courseindex-progress"
             data-region="course-progress"
             data-status-template="{{#str}}courseindexprogressstatus, theme_compecer{{/str}}"
             data-no-tracking="{{#str}}courseindexprogressnone, theme_compecer{{/str}}"
             aria-live="polite">
            <div class="compecer-courseindex-progress__labels">
                <span class="compecer-courseindex-progress__title">{{#str}}courseindexprogresslabel, theme_compecer{{/str}}</span>
                <span class="compecer-courseindex-progress__value" data-region="course-progress-value">0%</span>
            </div>
            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div class="progress-bar" data-region="course-progress-bar" style="width: 0%;"></div>
            </div>
            <span class="compecer-courseindex-progress__summary" data-region="course-progress-status">
                {{#str}}courseindexprogressplaceholder, theme_compecer{{/str}}
            </span>
        </div>
    </div>
    <div id="course-index" class="courseindex compecer-courseindex-tree {{#editmode}}editing{{/editmode}}" role="tree">
        {{#sections}}
            {{> core_courseformat/local/courseindex/section }}
        {{/sections}}
        {{^sections}}
            <p class="compecer-courseindex-empty">{{#str}}courseindexempty, theme_compecer{{/str}}</p>
        {{/sections}}
    </div>
</div>
{{#js}}
require(['core_courseformat/local/courseindex/courseindex'], function(component) {
    component.init('course-index');

    const root = document.getElementById('course-index');
    if (!root || root.dataset.progressInitialised) {
        return;
    }
    root.dataset.progressInitialised = 'true';

    const panel = root.closest('.compecer-courseindex-panel');
    if (!panel) {
        return;
    }

    const progressContainer = panel.querySelector('[data-region="course-progress"]');
    const progressBar = progressContainer ? progressContainer.querySelector('[data-region="course-progress-bar"]') : null;
    const progressValue = progressContainer ? progressContainer.querySelector('[data-region="course-progress-value"]') : null;
    const progressStatus = progressContainer ? progressContainer.querySelector('[data-region="course-progress-status"]') : null;
    const statusTemplate = progressContainer ? progressContainer.dataset.statusTemplate || '' : '';
    const noTrackingText = progressContainer ? progressContainer.dataset.noTracking || '' : '';
    const placeholderText = progressStatus ? progressStatus.textContent.trim() : '';

    const getCompletionSummary = function(scope, owner) {
        const completionNodes = scope.querySelectorAll('[data-for="cm_completion"]');
        const seen = new Set();
        let total = 0;
        let completed = 0;

        completionNodes.forEach(function(node) {
            if (owner) {
                const parentSection = node.closest('[data-for="section"]');
                if (parentSection && parentSection !== owner) {
                    return;
                }
            }

            const cmItem = node.closest('[data-for="cm"]');
            if (!cmItem) {
                return;
            }

            const cmId = cmItem.dataset.id;
            if (!cmId || seen.has(cmId)) {
                return;
            }
            seen.add(cmId);

            const isTracked = node.classList.contains('completion_complete') ||
                node.classList.contains('completion_incomplete') ||
                node.classList.contains('completion_fail');

            if (!isTracked) {
                return;
            }

            total++;
            if (node.classList.contains('completion_complete')) {
                completed++;
            }
        });

        return {
            total,
            completed
        };
    };

    const formatStatus = function(completed, total) {
        if (!total) {
            return noTrackingText || placeholderText;
        }
        if (!statusTemplate) {
            return completed + ' / ' + total;
        }
        return statusTemplate
            .replace('{$a->completed}', completed)
            .replace('{$a->total}', total);
    };

    const updateCourseProgress = function() {
        const summary = getCompletionSummary(root);
        const total = summary.total;
        const completed = summary.completed;
        const percent = total ? Math.round((completed / total) * 100) : 0;

        if (progressContainer) {
            progressContainer.classList.toggle('is-empty', !total);
            progressContainer.setAttribute('aria-label', formatStatus(completed, total));
        }

        if (progressBar) {
            progressBar.style.width = percent + '%';
            progressBar.setAttribute('aria-valuenow', percent);
        }

        if (progressValue) {
            progressValue.textContent = percent + '%';
        }

        if (progressStatus) {
            progressStatus.textContent = formatStatus(completed, total);
        }
    };

    const updateSectionProgress = function() {
        const sections = root.querySelectorAll('.courseindex-section');
        sections.forEach(function(section) {
            const progress = section.querySelector('[data-region="section-progress"]');
            if (!progress) {
                return;
            }

            const sectionSummary = getCompletionSummary(section, section);
            const total = sectionSummary.total;
            const completed = sectionSummary.completed;
            const percent = total ? Math.round((completed / total) * 100) : 0;

            const bar = progress.querySelector('[data-region="section-progress-bar"]');
            const value = progress.querySelector('[data-region="section-progress-value"]');
            const count = progress.querySelector('[data-region="section-progress-count"]');
            const emptyText = progress.dataset.emptyText || '\u2014';

            if (bar) {
                bar.style.width = percent + '%';
                bar.setAttribute('aria-valuenow', percent);
            }

            if (!total) {
                progress.classList.add('is-empty');
                progress.setAttribute('aria-label', emptyText);
                if (value) {
                    value.textContent = emptyText;
                }
                if (count) {
                    count.textContent = '';
                }
                if (bar) {
                    bar.style.width = '0%';
                    bar.setAttribute('aria-valuenow', 0);
                }
                return;
            }

            progress.classList.remove('is-empty');
            progress.setAttribute('aria-label', percent + '% (' + completed + '/' + total + ')');

            if (value) {
                value.textContent = percent + '%';
            }
            if (count) {
                count.textContent = completed + ' / ' + total;
            }
        });
    };

    const updateAllProgress = function() {
        updateCourseProgress();
        updateSectionProgress();
    };

    const observer = new MutationObserver(function(mutations) {
        if (!mutations.length) {
            return;
        }
        updateAllProgress();
    });

    observer.observe(root, {
        subtree: true,
        childList: true,
        attributes: true,
        attributeFilter: ['class', 'data-value']
    });

    updateAllProgress();
});
{{/js}}
