{{!
    @template core_courseformat/local/courseindex/drawer

    Course Index Drawer - Theme Compecer

    This template renders the course index drawer with progress bars.
    Progress data comes from both server-side (global) and client-side (sections).

    Example context (json):
    {
        "hasprogress": true,
        "progresspercentage": 65,
        "progresswidth": 65
    }
}}
<nav id="courseindex" class="courseindex" aria-label="{{#str}}courseindex, core_courseformat{{/str}}">
    {{! Header Section }}
    <div class="courseindex-header">
        <div class="courseindex-title">
            <h5 class="mb-0">{{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}</h5>
        </div>

        {{! Global Course Progress - Server-side rendered }}
        {{#hasprogress}}
        <div class="courseindex-progress-global mt-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="progress-label">{{#str}}courseindexprogresslabel, theme_compecer{{/str}}</span>
                <span class="progress-percentage">{{progresspercentage}}%</span>
            </div>
            <div class="progress courseindex-progress-bar">
                <div class="progress-bar bg-success"
                     role="progressbar"
                     style="width: {{progresswidth}}%;"
                     aria-valuenow="{{progresspercentage}}"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    <span class="sr-only">{{progresspercentage}}% {{#str}}completepercent, theme_compecer, {{progresspercentage}}{{/str}}</span>
                </div>
            </div>
        </div>
        {{/hasprogress}}

        {{! Expand/Collapse Controls }}
        <div class="courseindex-controls d-flex justify-content-end mt-2 mb-2">
            <button type="button"
                    class="btn btn-sm btn-link p-1 mr-2"
                    data-action="expandallcourseindexsections"
                    aria-label="{{#str}}expandall, theme_compecer{{/str}}">
                <i class="fa fa-angle-double-down"></i>
            </button>
            <button type="button"
                    class="btn btn-sm btn-link p-1"
                    data-action="collapseallcourseindexsections"
                    aria-label="{{#str}}collapseall, theme_compecer{{/str}}">
                <i class="fa fa-angle-double-up"></i>
            </button>
        </div>
    </div>

    {{! Course Content }}
    <div id="courseindex-content" class="courseindex-content">
        {{> core_courseformat/local/courseindex/placeholders}}
    </div>
</nav>

{{#js}}
require(['core_courseformat/local/courseindex/drawer'], function(drawer) {
    drawer.init('courseindex');
});

// CourseIndex Progress Enhancement - Inline version (no AMD compilation needed)
require(['core/ajax', 'core/str'], function(Ajax, Str) {
    var courseId = M.cfg.courseId || {{courseid}};
    if (!courseId) {
        return;
    }

    // Function to inject section progress bars
    function injectSectionProgress(sectionsData) {
        sectionsData.forEach(function(sectionData) {
            if (!sectionData.enabled || sectionData.total === 0) {
                return;
            }

            // Find the section element
            var sectionElement = document.querySelector('[data-for="section"][data-number="' + sectionData.sectionnumber + '"]');
            if (!sectionElement) {
                return;
            }

            // Check if progress already injected
            if (sectionElement.querySelector('.courseindex-section-progress')) {
                return;
            }

            // Create progress HTML
            Str.get_string('activitiescompletedcount', 'theme_compecer', {
                completed: sectionData.completed,
                total: sectionData.total
            }).done(function(progressText) {
                var progressHTML = '<div class="courseindex-section-progress mt-2">' +
                    '<div class="d-flex justify-content-between align-items-center mb-1">' +
                    '<span class="progress-text small text-muted">' + progressText + '</span>' +
                    '<span class="progress-percentage small font-weight-bold">' + sectionData.percentage + '%</span>' +
                    '</div>' +
                    '<div class="progress courseindex-progress-bar-sm" style="height: 6px;">' +
                    '<div class="progress-bar bg-success" role="progressbar" ' +
                    'style="width: ' + sectionData.percentage + '%;" ' +
                    'aria-valuenow="' + sectionData.percentage + '" ' +
                    'aria-valuemin="0" aria-valuemax="100">' +
                    '<span class="sr-only">' + sectionData.percentage + '% Complete</span>' +
                    '</div>' +
                    '</div>' +
                    '</div>';

                // Find the section header
                var sectionHeader = sectionElement.querySelector('[data-for="section_item"]');
                if (sectionHeader) {
                    sectionHeader.insertAdjacentHTML('beforeend', progressHTML);
                }
            });
        });
    }

    // Wait for courseindex to be loaded
    setTimeout(function() {
        // Call webservice to get progress data
        Ajax.call([{
            methodname: 'theme_compecer_get_course_progress',
            args: {courseid: courseId}
        }])[0].done(function(data) {
            // Inject section progress
            if (data.sections && data.sections.length > 0) {
                injectSectionProgress(data.sections);
            }
        }).fail(function(error) {
            // Silent fail - global progress still works from server-side
            if (window.console && console.log) {
                console.log('CourseIndex: Could not load section progress', error);
            }
        });
    }, 500); // Wait 500ms for courseindex to be fully rendered
});
{{/js}}
