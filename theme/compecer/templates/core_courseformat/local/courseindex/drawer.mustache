{{!
    @template core_courseformat/local/courseindex/drawer

    This template renders the course index drawer.
    Adaptado para theme compecer (child theme de Boost).
    
    Example context (json):
    {}
}}
<nav id="courseindex" class="compecer-courseindex-drawer" aria-label="{{#str}}courseindexdraweraria, theme_compecer{{/str}}">
  <div class="compecer-courseindex-drawer__heading">
    <span class="compecer-courseindex-drawer__title" title="{{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}">
      {{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}
    </span>
    <p class="compecer-courseindex-drawer__description">
      {{#str}}courseindexdrawerdescription, theme_compecer{{/str}}
    </p>
  </div>
  <div id="courseindex-content" class="compecer-courseindex-drawer__content">
    {{> core_courseformat/local/courseindex/placeholders}}
  </div>
</nav>
{{#js}}
require(['core_courseformat/local/courseindex/drawer'], function(component) {
  component.init('courseindex');
});
{{/js}}
