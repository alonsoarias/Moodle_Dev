{{!
    @template core_courseformat/local/courseindex/drawer

    This template renders the course index drawer.
    Adaptado para theme compecer (child theme de Boost).
    
    Example context (json):
    {}
}}
<nav id="courseindex" class="course-index-drawer" data-region="courseindex">
  <header class="ci-drawer-header">
    <span class="ci-drawer-title" title="{{#str}}courseindexheading, theme_compecer{{/str}}">
      {{#str}}courseindexheading, theme_compecer{{/str}}
    </span>
    <div class="ci-progress-block" data-region="course-progress-wrapper">
      <div class="ci-progress-meta">
        <span class="ci-progress-label">{{#str}}courseprogresslabel, theme_compecer{{/str}}</span>
        <span class="ci-progress-value" data-region="course-progress-label" aria-live="polite">0%</span>
      </div>
      <div class="ci-progress-meter" role="presentation">
        <span class="ci-progress-meter-fill"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              style="width: 0%"
              data-region="course-progress-bar"></span>
      </div>
      <div class="ci-progress-caption">
        <span class="ci-progress-fraction"
              data-region="course-progress-fraction"
              aria-live="polite">{{#str}}courseprogressloading, theme_compecer{{/str}}</span>
      </div>
      <span class="sr-only" data-region="course-progress-a11y" aria-live="polite"></span>
    </div>
    <div class="ci-progress-disabled"
         data-region="course-progress-disabled"
         role="status"
         aria-live="polite"
         hidden>
      {{#str}}courseprogressdisabled, theme_compecer{{/str}}
    </div>
  </header>
  <div class="ci-drawer-body" id="courseindex-content">
    {{> core_courseformat/local/courseindex/placeholders}}
  </div>
</nav>
{{#js}}
require(['core_courseformat/local/courseindex/drawer', 'theme_compecer/courseindex_progress'], function(component, progress) {
  component.init('courseindex');
  progress.init('courseindex');
});
{{/js}}
