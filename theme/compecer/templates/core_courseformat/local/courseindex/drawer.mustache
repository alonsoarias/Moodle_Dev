{{!
    @template core_courseformat/local/courseindex/drawer
    
    Course index drawer - Compecer minimal design inspired by Remui
    
    Context variables:
    * progress - Progress data object with course, sections, activities
}}
<nav id="courseindex" class="courseindex courseindex--compecer{{^progress.enabled}} courseindex--no-tracking{{/progress.enabled}}" data-progress='{{{progress.dataset}}}'>

    <div class="courseindex-progress-card {{^progress.enabled}}courseindex-progress-card--disabled{{/progress.enabled}}"
         role="region"
         aria-live="polite"
         aria-label="{{progress.course.title}}">
        <div class="courseindex-progress-card__header">
            <div class="courseindex-progress-card__heading">
                <p class="courseindex-progress-card__title">{{progress.course.title}}</p>
                <p class="courseindex-progress-card__summary" data-region="course-progress-summary">
                    {{progress.course.summary}}
                </p>
            </div>
            <span class="courseindex-progress-card__value" data-region="course-progress-value">
                {{progress.course.percentageformatted}}
            </span>
        </div>
        {{#progress.enabled}}
        <div class="courseindex-progress-bar"
             role="progressbar"
             aria-valuemin="0"
             aria-valuemax="100"
             aria-valuenow="{{progress.course.percentage}}"
             aria-label="{{progress.course.aria}}">
            <span class="courseindex-progress-bar__visual" data-region="course-progress-bar" aria-hidden="true">
                {{progress.course.bar}}
            </span>
        </div>
        {{/progress.enabled}}
        {{^progress.enabled}}
        <div class="courseindex-progress-card__message" data-region="course-progress-message">
            {{progress.course.summary}}
        </div>
        {{/progress.enabled}}
        <span class="sr-only" data-region="course-progress-text">{{progress.course.aria}}</span>
    </div>

    <div class="courseindex-body">
        <div id="courseindex-content" class="courseindex-content" data-region="courseindex-content">
            {{> core_courseformat/local/courseindex/placeholders}}
        </div>
    </div>

</nav>

{{#js}}
require(['core_courseformat/courseeditor'], function(courseeditor) {
    const editor = courseeditor?.getCurrentCourseEditor?.();
    if (!editor) {
        return;
    }
    require(['core_courseformat/local/courseindex/drawer', 'theme_compecer/courseindex_progress'], function(component, progress) {
        component.init('courseindex');
        progress.init('courseindex', editor);
    });
});
{{/js}}
