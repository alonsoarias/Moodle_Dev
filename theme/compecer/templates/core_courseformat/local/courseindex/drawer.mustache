{{!
    @template core_courseformat/local/courseindex/drawer

    This template renders the course index drawer.
    Adaptado para theme compecer (child theme de Boost).
    
    Example context (json):
    {}
}}
<nav id="courseindex" class="course-index-drawer" data-region="courseindex">
  <div class="ci-course-progress-wrapper mb-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
      <span class="course-heading font-weight-bold" title="{{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}">
        {{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}
      </span>
      <span class="ci-course-progress-value" data-region="course-progress-label">0%</span>
    </div>
    <div class="progress ci-course-progress-bar" role="presentation">
      <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
           style="width: 0%" data-region="course-progress-bar"></div>
    </div>
    <div class="ci-course-progress-summary text-muted" data-region="course-progress-fraction"></div>
    <span class="sr-only" data-region="course-progress-a11y"></span>
  </div>
  <div class="ci-course-progress-disabled alert alert-info py-2 px-3" data-region="course-progress-disabled" hidden>
    {{#str}}courseprogressdisabled, theme_compecer{{/str}}
  </div>
  <div id="courseindex-content">
    {{> core_courseformat/local/courseindex/placeholders}}
  </div>
</nav>
{{#js}}
require(['core_courseformat/local/courseindex/drawer', 'theme_compecer/courseindex_progress'], function(component, progress) {
  component.init('courseindex');
  progress.init('courseindex');
});
{{/js}}
