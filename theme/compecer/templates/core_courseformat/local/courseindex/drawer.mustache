{{!
    @template core_courseformat/local/courseindex/drawer

    Custom drawer for the course index including a dynamic progress bar.
}}
<nav id="courseindex" class="courseindex courseindex--compecer" data-region="course-index"{{#courseid}} data-courseid="{{.}}"{{/courseid}}>
    <header class="courseindex__header">
        <div class="courseindex__heading">
            <span class="course-heading h-bold-4" title="{{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}">
                {{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}
            </span>
        </div>
        <section class="courseindex-progress{{^progress}} courseindex-progress--disabled{{/progress}}"
                 data-region="course-progress"
                 aria-live="polite"
                 data-progress-enabled="{{#progressenabled}}1{{/progressenabled}}{{^progressenabled}}0{{/progressenabled}}"
                 {{#progress}}
                 data-progress-percentage="{{percentage}}"
                 data-progress-completed="{{completed}}"
                 data-progress-incomplete="{{incomplete}}"
                 data-progress-total="{{total}}"
                 {{/progress}}>
            <div class="courseindex-progress__meta">
                <span class="courseindex-progress__label">
                    {{#str}}courseprogresslabel, theme_compecer{{/str}}
                </span>
                <span class="courseindex-progress__value" data-region="progress-value" aria-hidden="true">{{#progress}}{{percentageformatted}}%{{/progress}}{{^progress}}--{{/progress}}</span>
            </div>
            <div class="progress courseindex-progress__track"
                 role="progressbar"
                 aria-label="{{#str}}courseprogresslabel, theme_compecer{{/str}}"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="{{#progress}}{{percentage}}{{/progress}}{{^progress}}0{{/progress}}"
                 data-region="progress-bar">
                <div class="progress-bar" style="width: {{#progress}}{{percentage}}{{/progress}}{{^progress}}0{{/progress}}%;"></div>
            </div>
            <div class="courseindex-progress__details" data-region="progress-details" {{^progress}}hidden{{/progress}}>
                <span class="courseindex-progress__stat courseindex-progress__stat--completed">
                    <span class="sr-only">{{#str}}courseprogresscompleted, theme_compecer{{/str}}</span>
                    <span aria-hidden="true" data-region="progress-completed-value">{{#progress}}{{completed}}{{/progress}}{{^progress}}0{{/progress}}</span>
                    <span class="courseindex-progress__stat-text" data-region="progress-completed-text">
                        {{#progress}}{{completedformatted}}{{/progress}}{{^progress}}{{#str}}courseprogresscompletedshort, theme_compecer, 0{{/str}}{{/progress}}
                    </span>
                </span>
                <span class="courseindex-progress__divider" aria-hidden="true">•</span>
                <span class="courseindex-progress__stat courseindex-progress__stat--remaining">
                    <span class="sr-only">{{#str}}courseprogressremaining, theme_compecer{{/str}}</span>
                    <span aria-hidden="true" data-region="progress-remaining-value">{{#progress}}{{incomplete}}{{/progress}}{{^progress}}0{{/progress}}</span>
                    <span class="courseindex-progress__stat-text" data-region="progress-remaining-text">
                        {{#progress}}{{incompleteformatted}}{{/progress}}{{^progress}}{{#str}}courseprogressremainingshort, theme_compecer, 0{{/str}}{{/progress}}
                    </span>
                </span>
            </div>
            <p class="courseindex-progress__notice{{#progress}} sr-only{{/progress}}" data-region="progress-notice">
                {{#progress}}{{#str}}courseprogressloading, theme_compecer{{/str}}{{/progress}}
                {{^progress}}{{#str}}courseprogressnotracking, theme_compecer{{/str}}{{/progress}}
            </p>
        </section>
    </header>
    <div id="courseindex-content">
        {{> core_courseformat/local/courseindex/placeholders }}
    </div>
</nav>
{{#js}}
require(['core_courseformat/local/courseindex/drawer'], function(component) {
    component.init('courseindex');
});
require(['theme_compecer/courseindex'], function(progress) {
    progress.init({rootId: 'courseindex'});
});
{{/js}}
