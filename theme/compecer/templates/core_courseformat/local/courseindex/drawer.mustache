{{!
    @template core_courseformat/local/courseindex/drawer

    This template renders the course index drawer with progress tracking.
    Adaptado para theme compecer (child theme de Boost).

    Example context (json):
    {}
}}
<nav id="courseindex" class="course-index-drawer">
  <div class="drawer-header mb-3">
    <span class="course-heading font-weight-bold" title="{{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}">
      {{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}
    </span>
  </div>

  {{! Progreso global del curso reutilizando estructura de RemUI }}
  <div id="courseindex-progress-container"
       class="course-prgress-container mb-3"
       data-courseid="{{courseid}}"
       style="display:none;">
    <h6 class="courseprogress mt-0 bold">
      {{#str}}courseprogressheading, theme_compecer{{/str}}
    </h6>
    <div class="progress progress-rounded mb-3">
      <div class="progress-bar bg-green-600"
           data-region="progress-bar"
           role="progressbar"
           style="width: 0%;"
           aria-valuenow="0"
           aria-valuemin="0"
           aria-valuemax="100">
        <span class="sr-only" data-region="progress-bar-sr">0%</span>
      </div>
    </div>
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
      <div class="progress-metric d-flex align-items-center">
        <span class="progress-percentage h5 mb-0 mr-2" data-region="progress-percentage">0%</span>
        <span class="progress-details" data-region="progress-details">0 / 0</span>
      </div>
      <ul class="section-activities-summary list-unstyled mb-0 mt-2 mt-md-0 d-flex flex-wrap"
          data-region="activity-list">
      </ul>
    </div>
  </div>

  <div id="courseindex-content">
    {{> core_courseformat/local/courseindex/placeholders}}
  </div>
</nav>
{{#js}}
require(['core_courseformat/local/courseindex/drawer'], function(component) {
  component.init('courseindex');
});
require(['jquery', 'theme_compecer/courseindex_progress'], function($, progressComponent) {
  // Get courseid from Moodle page config
  var courseid = M.cfg.courseId;
  if (courseid && courseid > 0) {
    progressComponent.init(courseid);
  }
});
{{/js}}
