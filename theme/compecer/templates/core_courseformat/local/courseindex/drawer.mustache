{{!
    @template core_courseformat/local/courseindex/drawer

    Custom course index drawer for theme Compecer with progress overview.
}}
<nav id="courseindex" class="course-index-drawer" data-progress='{{{progress.dataset}}}'>
  <div class="course-index-overview" aria-live="polite">
    <div class="course-index-overview__header">
      <p class="course-index-overview__title">{{progress.course.title}}</p>
      <p class="course-index-overview__value" data-region="course-progress-value">{{progress.course.percentageformatted}}</p>
    </div>
    <p class="course-index-overview__description" data-region="course-progress-summary">{{progress.course.summary}}</p>
    <div class="course-index-overview__bar" role="presentation">
      <span class="course-index-overview__fill" style="--course-progress: {{#progress.course.percentage}}{{.}}%{{/progress.course.percentage}}{{^progress.course.percentage}}0%{{/progress.course.percentage}};" role="progressbar" aria-valuemin="0" aria-valuemax="100" {{#progress.course.percentage}}aria-valuenow="{{.}}"{{/progress.course.percentage}} aria-label="{{progress.course.aria}}"></span>
    </div>
  </div>
  <span class="course-heading" title="{{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}">
    {{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}
  </span>
  <div id="courseindex-content" data-region="courseindex-content">
    {{> core_courseformat/local/courseindex/placeholders}}
  </div>
</nav>
{{#js}}
require(['core_courseformat/local/courseindex/drawer', 'theme_compecer/courseindex_progress'], function(component, progress) {
  component.init('courseindex');
  progress.init('courseindex');
});
{{/js}}
