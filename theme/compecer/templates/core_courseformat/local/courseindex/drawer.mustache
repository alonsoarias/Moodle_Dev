{{!
    @template core_courseformat/local/courseindex/drawer

    This template renders the course index drawer.
    Adaptado para theme compecer (child theme de Boost).
    
    Example context (json):
    {}
}}
<nav id="courseindex" class="courseindex" data-region="courseindex">
  <header class="courseindex-header">
    <span class="course-heading h-bold-4" title="{{#str}}courseindexheading, theme_compecer{{/str}}">
      {{#str}}courseindexheading, theme_compecer{{/str}}
    </span>
    <div class="courseindex-progress" data-region="course-progress">
      <div class="courseindex-progress-line" aria-live="polite">
        <span class="courseindex-progress-label">{{#str}}courseprogresslabel, theme_compecer{{/str}}</span>
        <span class="courseindex-progress-separator" aria-hidden="true">·</span>
        <span class="courseindex-progress-value" data-region="course-progress-value">0%</span>
      </div>
      <div class="courseindex-progress-meter" role="presentation">
        <span class="courseindex-progress-bar"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              style="width: 0%"
              data-region="course-progress-bar"></span>
      </div>
      <div class="courseindex-progress-caption">
        <span class="courseindex-progress-summary"
              data-region="course-progress-summary"
              aria-live="polite">{{#str}}courseprogressloading, theme_compecer{{/str}}</span>
      </div>
      <span class="sr-only" data-region="course-progress-a11y" aria-live="polite"></span>
    </div>
    <div class="courseindex-progress-disabled"
         data-region="course-progress-disabled"
         role="status"
         aria-live="polite"
         hidden>
      {{#str}}courseprogressdisabled, theme_compecer{{/str}}
    </div>
  </header>
  <div class="courseindex-body" id="courseindex-content">
    {{> core_courseformat/local/courseindex/placeholders}}
  </div>
</nav>
{{#js}}
require(['core_courseformat/local/courseindex/drawer', 'theme_compecer/courseindex_progress'], function(component, progress) {
  component.init('courseindex');
  progress.init('courseindex');
});
{{/js}}
