{{!
    @template core_courseformat/local/courseindex/drawer

    Custom drawer for the course index including a dynamic progress bar.
}}
<nav id="courseindex" class="courseindex courseindex--compecer" data-region="course-index">
    <header class="courseindex__header">
        <div class="courseindex__heading">
            <span class="course-heading h-bold-4" title="{{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}">
                {{#str}}sidebarcoursemenuheading, theme_compecer{{/str}}
            </span>
        </div>
        <section class="courseindex-progress" data-region="course-progress" aria-live="polite">
            <div class="courseindex-progress__meta">
                <span class="courseindex-progress__label">
                    {{#str}}courseprogresslabel, theme_compecer{{/str}}
                </span>
                <span class="courseindex-progress__value" data-region="progress-value" aria-hidden="true">0%</span>
            </div>
            <div class="progress courseindex-progress__track"
                 role="progressbar"
                 aria-label="{{#str}}courseprogresslabel, theme_compecer{{/str}}"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="0"
                 data-region="progress-bar">
                <div class="progress-bar" style="width: 0%;"></div>
            </div>
            <div class="courseindex-progress__details" data-region="progress-details">
                <span class="courseindex-progress__stat courseindex-progress__stat--completed">
                    <span class="sr-only">{{#str}}courseprogresscompleted, theme_compecer{{/str}}</span>
                    <span aria-hidden="true" data-region="progress-completed-value">0</span>
                    <span class="courseindex-progress__stat-text" data-region="progress-completed-text">
                        {{#str}}courseprogresscompletedshort, theme_compecer, 0{{/str}}
                    </span>
                </span>
                <span class="courseindex-progress__divider" aria-hidden="true">•</span>
                <span class="courseindex-progress__stat courseindex-progress__stat--remaining">
                    <span class="sr-only">{{#str}}courseprogressremaining, theme_compecer{{/str}}</span>
                    <span aria-hidden="true" data-region="progress-remaining-value">0</span>
                    <span class="courseindex-progress__stat-text" data-region="progress-remaining-text">
                        {{#str}}courseprogressremainingshort, theme_compecer, 0{{/str}}
                    </span>
                </span>
            </div>
            <p class="courseindex-progress__notice sr-only" data-region="progress-notice">
                {{#str}}courseprogressloading, theme_compecer{{/str}}
            </p>
        </section>
    </header>
    <div id="courseindex-content">
        {{> core_courseformat/local/courseindex/placeholders }}
    </div>
</nav>
{{#js}}
require(['core_courseformat/local/courseindex/drawer'], function(component) {
    component.init('courseindex');
});
require(['theme_compecer/courseindex'], function(progress) {
    progress.init({rootId: 'courseindex'});
});
{{/js}}
