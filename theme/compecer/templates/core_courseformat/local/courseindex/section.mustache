{{!
    @template core_courseformat/local/courseindex/section

    Displays a course index section entry.
    Adaptado para theme compecer.
    Se utiliza un único icono de toggle (chevron) para controlar el colapso/expansión.
    Por defecto, la sección se muestra cerrada.
    
    Example context (json):
    {
      "title": "General",
      "id": 23,
      "uniqid": "0",
      "number": 1,
      "sectionurl": "#",
      "indexcollapsed": 1,
      "current": 1,
      "visible": 1,
      "hasrestrictions": 0,
      "highlighted": "1",
      "cms": [ ... ]
    }
}}
<div class="course-index-section w-100 {{#current}}current{{/current}} {{#component}}delegated-section{{/component}}"
     id="{{uniqid}}-course-index-section-{{id}}"
     data-for="section"
     data-id="{{id}}"
     data-number="{{number}}"
     role="treeitem"
     aria-owns="course-index-collapse{{number}}">
  <div class="ci-section-header courseindex-item {{^visible}}dimmed{{/visible}} {{#hasrestrictions}}restrictions{{/hasrestrictions}}"
       id="course-index-section{{number}}"
       data-for="section_item">
    <button type="button"
            data-toggle="collapse"
            data-target="#course-index-collapse{{number}}"
            class="ci-section-toggle {{#indexcollapsed}}collapsed{{/indexcollapsed}}"
            aria-expanded="{{^indexcollapsed}}true{{/indexcollapsed}}{{#indexcollapsed}}false{{/indexcollapsed}}"
            aria-controls="course-index-collapse{{number}}">
      <span class="ci-section-title text-truncate"
            data-for="section_title"
            title="{{{title}}}">
        {{{title}}}
      </span>
      <span class="ci-section-meta">
        <span class="ci-section-fraction"
              data-region="section-progress-fraction"
              aria-live="polite">
          {{#str}}sectionprogressloading, theme_compecer{{/str}}
        </span>
        <span class="ci-section-caret" aria-hidden="true"></span>
      </span>
      <span class="sr-only">{{#str}}toggle section{{/str}}</span>
    </button>
    <div class="ci-section-progress"
         data-region="section-progress"
         data-section-id="{{id}}"
         hidden>
      <div class="ci-section-progress-meter" role="presentation">
        <span class="ci-section-progress-fill"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              data-region="section-progress-bar"></span>
      </div>
      <span class="ci-section-progress-label"
            data-region="section-progress-label"
            aria-live="polite">
        {{#str}}sectionprogressloading, theme_compecer{{/str}}
      </span>
      <span class="sr-only" data-region="section-progress-a11y" aria-live="polite"></span>
    </div>
  </div>
  <div id="course-index-collapse{{number}}"
       class="ci-section-panel course-index-content collapse {{^indexcollapsed}}show{{/indexcollapsed}}"
       aria-labelledby="course-index-section{{number}}" role="group">
    <ul class="course-index-section-content list-unstyled" data-for="cmlist" data-id="{{id}}" role="group">
      {{#cms}}
        {{> core_courseformat/local/courseindex/cm}}
      {{/cms}}
    </ul>
  </div>
</div>
{{#js}}
require(['core_courseformat/local/courseindex/section'], function(component) {
  component.init('{{uniqid}}-course-index-section-{{id}}');
});
{{/js}}
