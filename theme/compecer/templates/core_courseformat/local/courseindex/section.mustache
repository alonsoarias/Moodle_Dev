{{!
    @template core_courseformat/local/courseindex/section

    Displays a course index section entry.
    Adaptado para theme compecer.
    Se utiliza un único icono de toggle (chevron) para controlar el colapso/expansión.
    Por defecto, la sección se muestra cerrada.
    
    Example context (json):
    {
      "title": "General",
      "id": 23,
      "uniqid": "0",
      "number": 1,
      "sectionurl": "#",
      "indexcollapsed": 1,
      "current": 1,
      "visible": 1,
      "hasrestrictions": 0,
      "highlighted": "1",
      "cms": [ ... ]
    }
}}
<div class="courseindex-section w-100 {{#current}}current{{/current}} {{#component}}delegated-section{{/component}}"
     id="{{uniqid}}-courseindex-section-{{id}}"
     data-for="section"
     data-id="{{id}}"
     data-number="{{number}}"
     role="treeitem"
     aria-owns="courseindexcollapse{{number}}">
  <div class="courseindex-section__header {{^visible}}dimmed{{/visible}} {{#hasrestrictions}}restrictions{{/hasrestrictions}}"
       id="courseindexsection{{number}}"
       data-for="section_item">
    <div class="courseindex-section__title">
      <button type="button"
              class="courseindex-section__toggle {{#indexcollapsed}}is-collapsed collapsed{{/indexcollapsed}}"
              data-action="togglecourseindexsection"
              data-toggle="collapse"
              data-target="#courseindexcollapse{{number}}"
              data-for="section_title"
              aria-controls="courseindexcollapse{{number}}"
              aria-expanded="{{^indexcollapsed}}true{{/indexcollapsed}}{{#indexcollapsed}}false{{/indexcollapsed}}"
              tabindex="-1">
        <span class="courseindex-section__toggle-icon" aria-hidden="true"></span>
        <span class="sr-only">{{#str}}courseindex_toggle_section, theme_compecer{{/str}}</span>
      </button>
      <a href="{{{sectionurl}}}"
         class="courseindex-section__name text-truncate"
         data-for="section_title"
         tabindex="-1"
         title="{{{title}}}">
        {{{title}}}
      </a>
      {{#highlighted}}
      <span class="courseindex-section__current badge badge-primary rounded-pill" aria-hidden="true">
        {{highlighted}}
      </span>
      {{/highlighted}}
    </div>
    <div class="courseindex-section__progress" role="presentation">
      <span class="courseindex-section__percentage" data-region="section-progress-value">0%</span>
      <span class="courseindex-section__summary" data-region="section-progress-summary">
        {{#str}}courseindex_section_nottracked, theme_compecer{{/str}}
      </span>
      <span class="sr-only" data-region="section-progress-text">
        {{#str}}courseindex_section_nottracked, theme_compecer{{/str}}
      </span>
      <div class="courseindex-section__bar">
        <div class="courseindex-section__bar-fill" data-region="section-progress-bar"></div>
      </div>
    </div>
  </div>
  <div id="courseindexcollapse{{number}}"
       class="courseindex-section__content collapse {{^indexcollapsed}}show{{/indexcollapsed}}"
       aria-labelledby="courseindexsection{{number}}" role="group">
    <ul class="courseindex-section__list" data-for="cmlist" data-id="{{id}}" role="group">
      {{#cms}}
        {{> core_courseformat/local/courseindex/cm}}
      {{/cms}}
    </ul>
  </div>
</div>
{{#js}}
require(['core_courseformat/local/courseindex/section'], function(component) {
  component.init('{{uniqid}}-courseindex-section-{{id}}');
});
{{/js}}
