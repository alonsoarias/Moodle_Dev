{{!
    @template core_courseformat/local/courseindex/section
    
    Course index section - Clean toggle-only design (NO navigation)
    
    Context variables:
    * id - Section ID
    * number - Section number
    * title - Section title
    * current - Boolean, is current section
    * visible - Boolean, is visible
    * indexcollapsed - Boolean, is collapsed
    * cms - Array of course modules
}}
<div class="courseindex-section {{#current}}courseindex-section--current{{/current}} {{#component}}courseindex-section--delegated{{/component}}"
     id="{{uniqid}}-course-index-section-{{id}}"
     data-for="section"
     data-id="{{id}}"
     data-number="{{number}}"
     role="treeitem"
     aria-owns="courseindex-section-content-{{number}}">

    <div class="courseindex-section__header {{^visible}}courseindex-section__header--dimmed{{/visible}} {{#hasrestrictions}}courseindex-section__header--restricted{{/hasrestrictions}}"
         id="courseindex-section-header-{{number}}"
         data-for="section_item">

        <button type="button"
                class="courseindex-section__toggle {{#indexcollapsed}}collapsed{{/indexcollapsed}}"
                data-action="togglecourseindexsection"
                data-for="section_title"
                data-toggle="collapse"
                data-target="#courseindex-section-content-{{number}}"
                aria-expanded="{{^indexcollapsed}}true{{/indexcollapsed}}{{#indexcollapsed}}false{{/indexcollapsed}}"
                aria-controls="courseindex-section-content-{{number}}">
            <span class="courseindex-section__toggle-icon" aria-hidden="true"></span>
            <span class="sr-only">
                {{#indexcollapsed}}{{#str}}expand, core{{/str}}{{/indexcollapsed}}{{^indexcollapsed}}{{#str}}collapse, core{{/str}}{{/indexcollapsed}}
                {{{title}}}
            </span>
        </button>

        <div class="courseindex-section__heading">
            <a href="{{{sectionurl}}}"
               class="courseindex-section__title"
               data-action="togglecourseindexsection"
               data-for="section_title"
               tabindex="-1">
                {{{title}}}
            </a>
            {{#current}}
            <span class="courseindex-section__badge" aria-label="{{highlighted}}">{{highlighted}}</span>
            {{/current}}
        </div>

        <div class="courseindex-section__progress" data-region="section-progress">
            <span class="courseindex-section__progress-value" data-region="section-progress-value">0%</span>
            <span class="courseindex-section__progress-bar" data-region="section-progress-bar" aria-hidden="true">░░░░░░░░░░░░░░░░░░░░</span>
            <span class="courseindex-section__progress-summary" data-region="section-progress-summary">&ndash;</span>
            <span class="sr-only" data-region="section-progress-text"></span>
        </div>

        {{#hasrestrictions}}
        <span class="courseindex-section__locked" data-for="section_restrictions">
            {{#pix}} t/locked, core {{/pix}}
        </span>
        {{/hasrestrictions}}

    </div>

    <div id="courseindex-section-content-{{number}}"
         class="courseindex-section__content collapse {{^indexcollapsed}}show{{/indexcollapsed}}{{#current}}show{{/current}}"
         aria-labelledby="courseindex-section-header-{{number}}"
         role="group">
        <ul class="courseindex-section__list" data-for="cmlist" data-id="{{id}}" role="group">
            {{#cms}}
                {{> core_courseformat/local/courseindex/cm}}
            {{/cms}}
        </ul>
    </div>

</div>

{{#js}}
require(['core_courseformat/local/courseindex/section'], function(component) {
    component.init('{{uniqid}}-course-index-section-{{id}}');
});
{{/js}}
