# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Package lock files (generated)
.package-lock.json
package-lock.json

# Linter configuration (usually project-specific, not needed in repo)
.eslintignore
.stylelintignore

# PHP CodeSniffer
phpcs.xml

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary files
*.tmp
*.temp
.cache/
local/educambot_backup_*/

# MBZ generator output directories (except split parts for download)
curso/backup_output_v3/
curso/backup_output_v4/*
!curso/backup_output_v4/mbz_split_v4/

# MBZ files are too large for GitHub (>100MB), exclude them
# Generate locally with: php curso/generate_mbz_incremental.php 11
curso/backup_output_incremental/*.mbz
curso/backup_output_chapter2/*.mbz

# Keep GIFT files for question import
!curso/backup_output_incremental/*.gift.txt

# Keep split MBZ parts for download (under 100MB each)
# To reconstruct: cat mbz_split/huellas-completo.mbz.part_* > huellas-completo.mbz
!curso/backup_output_incremental/mbz_split/
