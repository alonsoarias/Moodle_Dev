{{!
    @template format_nexusformat/local/content

    Nexus Format main content template with two-column layout.
    Activities open via direct links (no iframe due to Moodle's X-Frame-Options).

    Context variables required for this template:
    * nexusformat - Boolean indicating this is nexus format
    * courseid - The course ID
    * editing / notediting - Editing mode flags (integers for Mustache)
    * progress - Progress data object
    * sidebarunits - Array of unit objects for sidebar
    * sections - Array of section objects (from parent)
}}

<div id="nexus-format-container" class="nexus-format-container" data-courseid="{{courseid}}">
    {{#nexusformat}}
    <div class="nexus-layout {{#editing}}nexus-editing{{/editing}}">

        {{! Left Column - Main Content Area }}
        <div class="nexus-content-area" id="nexus-content-area">
            {{#editing}}
            {{! EDITING MODE: Show standard Moodle sections for editing }}
            <div class="nexus-editing-mode">
                <div class="nexus-editing-banner">
                    <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                    <span>{{#str}}currentsection, format_nexusformat{{/str}} - {{#str}}pluginname, format_nexusformat{{/str}}</span>
                </div>
                <h2 class="accesshide">{{{title}}}</h2>
                {{{completionhelp}}}
                <ul class="nexusformat" data-for="course_sectionlist">
                    {{#initialsection}}
                        {{> core_courseformat/local/content/section }}
                    {{/initialsection}}
                    {{#sections}}
                        {{> core_courseformat/local/content/section }}
                    {{/sections}}
                </ul>
                {{#numsections}}
                    {{^singlesection}}
                        {{> core_courseformat/local/content/addsection}}
                    {{/singlesection}}
                {{/numsections}}
                {{#bulkedittools}}
                    {{> core_courseformat/local/content/bulkedittools}}
                {{/bulkedittools}}
            </div>
            {{/editing}}

            {{#notediting}}
            {{! VIEW MODE: Show welcome message with link to first activity }}
            <div class="nexus-view-mode">
                <div class="nexus-welcome-card">
                    <div class="nexus-welcome-icon">
                        <i class="fa fa-graduation-cap fa-4x" aria-hidden="true"></i>
                    </div>
                    <h2 class="nexus-welcome-title">{{{title}}}</h2>

                    {{#hasfirstactivity}}
                    <p class="nexus-welcome-text">{{selectactivitytext}}</p>
                    <a href="{{firstactivity.url}}" class="btn btn-primary nexus-start-btn">
                        <i class="fa fa-play-circle" aria-hidden="true"></i>
                        {{#str}}lesson, format_nexusformat{{/str}}: {{firstactivity.name}}
                    </a>
                    {{/hasfirstactivity}}

                    {{^hasfirstactivity}}
                    <p class="nexus-welcome-text">{{#str}}no_gradable_activities, format_nexusformat{{/str}}</p>
                    {{/hasfirstactivity}}

                    <div class="nexus-course-stats">
                        <div class="nexus-stat">
                            <span class="nexus-stat-value">{{totalactivities}}</span>
                            <span class="nexus-stat-label">{{#str}}tab_activities, format_nexusformat{{/str}}</span>
                        </div>
                        {{#progress.hasactivities}}
                        <div class="nexus-stat">
                            <span class="nexus-stat-value">{{progress.completed}}/{{progress.total}}</span>
                            <span class="nexus-stat-label">{{#str}}status_completed, format_nexusformat{{/str}}</span>
                        </div>
                        {{/progress.hasactivities}}
                    </div>
                </div>

                {{! Section 0 content (General section) if it exists }}
                {{#initialsection}}
                <div class="nexus-general-section">
                    {{> core_courseformat/local/content/section }}
                </div>
                {{/initialsection}}
            </div>
            {{/notediting}}
        </div>

        {{! Right Column - Sidebar }}
        <div class="nexus-sidebar" id="nexus-sidebar">
            {{! Tabs }}
            <div class="nexus-tabs">
                <button class="nexus-tab active" data-tab="content" type="button">
                    <i class="fa fa-list" aria-hidden="true"></i>
                    <span>{{#str}}tab_content, format_nexusformat{{/str}}</span>
                </button>
                <button class="nexus-tab" data-tab="activities" type="button">
                    <i class="fa fa-tasks" aria-hidden="true"></i>
                    <span>{{#str}}tab_activities, format_nexusformat{{/str}}</span>
                </button>
                <button class="nexus-tab" data-tab="notes" type="button">
                    <i class="fa fa-pencil" aria-hidden="true"></i>
                    <span>{{#str}}tab_notes, format_nexusformat{{/str}}</span>
                </button>
            </div>

            {{! Tab Content }}
            <div class="nexus-tab-content">
                {{! Content Tab }}
                <div class="nexus-tab-pane active" id="nexus-tab-content" data-tab="content">
                    {{! Progress Bar - Always show if there are activities }}
                    {{#progress.hasactivities}}
                    <div class="nexus-progress-section">
                        <div class="nexus-progress-header">
                            <span class="nexus-progress-label">{{#str}}progress, format_nexusformat{{/str}}</span>
                            <span class="nexus-progress-percentage">{{progress.percentage}}%</span>
                        </div>
                        <div class="nexus-progress-bar">
                            <div class="nexus-progress-fill" style="width: {{progress.percentage}}%;"></div>
                        </div>
                        <div class="nexus-progress-info">
                            <span>{{progress.displaytext}}</span>
                        </div>
                        <div class="nexus-progress-scale">
                            <span>0</span>
                            <span>50</span>
                            <span>100</span>
                        </div>
                    </div>
                    {{/progress.hasactivities}}

                    {{! Units List }}
                    <div class="nexus-units-list">
                        {{#sidebarunits}}
                        <div class="nexus-unit {{#expanded}}expanded{{/expanded}}" data-unitid="{{id}}">
                            <div class="nexus-unit-header" role="button" tabindex="0" aria-expanded="{{#expanded}}true{{/expanded}}{{^expanded}}false{{/expanded}}">
                                <span class="nexus-unit-toggle">
                                    <i class="fa {{#expanded}}fa-chevron-down{{/expanded}}{{^expanded}}fa-chevron-right{{/expanded}}" aria-hidden="true"></i>
                                </span>
                                <span class="nexus-unit-name">{{name}}</span>
                                <span class="nexus-unit-count">({{lessoncount}})</span>
                            </div>
                            <div class="nexus-unit-lessons" {{^expanded}}style="display: none;"{{/expanded}}>
                                {{#lessons}}
                                <a href="{{url}}" class="nexus-lesson {{#completed}}completed{{/completed}} {{#isfirst}}first-lesson{{/isfirst}}"
                                   data-cmid="{{id}}">
                                    <span class="nexus-lesson-status">
                                        {{#hascompletion}}
                                            {{#completed}}
                                            <i class="fa fa-check-circle text-success" aria-hidden="true"></i>
                                            {{/completed}}
                                            {{^completed}}
                                            <i class="fa fa-circle-o" aria-hidden="true"></i>
                                            {{/completed}}
                                        {{/hascompletion}}
                                        {{^hascompletion}}
                                        <i class="fa fa-circle" aria-hidden="true"></i>
                                        {{/hascompletion}}
                                    </span>
                                    <img src="{{icon}}" alt="" class="nexus-lesson-icon" />
                                    <div class="nexus-lesson-info">
                                        <span class="nexus-lesson-num">{{num}}</span>
                                        <span class="nexus-lesson-name">{{name}}</span>
                                    </div>
                                </a>
                                {{/lessons}}
                            </div>
                        </div>
                        {{/sidebarunits}}

                        {{^sidebarunits}}
                        <div class="nexus-no-units">
                            <i class="fa fa-info-circle" aria-hidden="true"></i>
                            <p>{{#str}}no_gradable_activities, format_nexusformat{{/str}}</p>
                        </div>
                        {{/sidebarunits}}
                    </div>
                </div>

                {{! Activities Tab - Placeholder for Phase 4 }}
                <div class="nexus-tab-pane" id="nexus-tab-activities" data-tab="activities" style="display: none;">
                    <div class="nexus-coming-soon">
                        <i class="fa fa-tasks fa-2x" aria-hidden="true"></i>
                        <p>{{#str}}gradable_activities, format_nexusformat{{/str}}</p>
                        <small>Phase 4</small>
                    </div>
                </div>

                {{! Notes Tab - Placeholder for Phase 5 }}
                <div class="nexus-tab-pane" id="nexus-tab-notes" data-tab="notes" style="display: none;">
                    <div class="nexus-coming-soon">
                        <i class="fa fa-pencil fa-2x" aria-hidden="true"></i>
                        <p>{{#str}}my_notes, format_nexusformat{{/str}}</p>
                        <small>Phase 5</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/nexusformat}}

    {{^nexusformat}}
    {{! Fallback to standard format }}
    <div id="course-format-fallback">
        <h2 class="accesshide">{{{title}}}</h2>
        {{{completionhelp}}}
        <ul class="topics" data-for="course_sectionlist">
            {{#initialsection}}
                {{> core_courseformat/local/content/section }}
            {{/initialsection}}
            {{#sections}}
                {{> core_courseformat/local/content/section }}
            {{/sections}}
        </ul>
        {{#numsections}}
            {{^singlesection}}
                {{> core_courseformat/local/content/addsection}}
            {{/singlesection}}
        {{/numsections}}
        {{#bulkedittools}}
            {{> core_courseformat/local/content/bulkedittools}}
        {{/bulkedittools}}
    </div>
    {{/nexusformat}}
</div>

{{#js}}
require(['jquery'], function($) {
    'use strict';

    // Tab switching
    $(document).on('click', '.nexus-tab', function() {
        var tab = $(this).data('tab');
        $('.nexus-tab').removeClass('active');
        $(this).addClass('active');
        $('.nexus-tab-pane').hide();
        $('#nexus-tab-' + tab).show();
    });

    // Unit expand/collapse
    $(document).on('click keypress', '.nexus-unit-header', function(e) {
        if (e.type === 'keypress' && e.which !== 13 && e.which !== 32) {
            return;
        }
        e.preventDefault();

        var $unit = $(this).closest('.nexus-unit');
        var $lessons = $unit.find('.nexus-unit-lessons');
        var $icon = $(this).find('.nexus-unit-toggle i');
        var expanded = $unit.hasClass('expanded');

        if (expanded) {
            $lessons.slideUp(200);
            $unit.removeClass('expanded');
            $icon.removeClass('fa-chevron-down').addClass('fa-chevron-right');
            $(this).attr('aria-expanded', 'false');
        } else {
            $lessons.slideDown(200);
            $unit.addClass('expanded');
            $icon.removeClass('fa-chevron-right').addClass('fa-chevron-down');
            $(this).attr('aria-expanded', 'true');
        }
    });

    // Highlight current lesson based on URL (for returning to course)
    var currentUrl = window.location.href;
    $('.nexus-lesson').each(function() {
        var lessonUrl = $(this).attr('href');
        if (lessonUrl && currentUrl.indexOf(lessonUrl) !== -1) {
            $(this).addClass('active');
        }
    });
});
{{/js}}
