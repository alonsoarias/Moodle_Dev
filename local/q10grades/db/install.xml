<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/q10grades/db" VERSION="20251220" COMMENT="XMLDB file for Q10 Grades Sync plugin"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <!-- Table to store course mapping between Moodle and Q10 -->
    <TABLE NAME="local_q10grades_mapping" COMMENT="Stores mapping between Moodle courses and Q10 subjects">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Moodle course ID"/>
        <FIELD NAME="q10_subject_id" TYPE="char" LENGTH="100" NOTNULL="true" COMMENT="Q10 subject/materia ID"/>
        <FIELD NAME="q10_period_id" TYPE="char" LENGTH="100" NOTNULL="false" COMMENT="Q10 academic period ID"/>
        <FIELD NAME="q10_group_id" TYPE="char" LENGTH="100" NOTNULL="false" COMMENT="Q10 group/grupo ID"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" COMMENT="Whether sync is enabled"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_idx" UNIQUE="true" FIELDS="courseid"/>
        <INDEX NAME="q10_subject_idx" UNIQUE="false" FIELDS="q10_subject_id"/>
      </INDEXES>
    </TABLE>

    <!-- Table to store user mapping between Moodle and Q10 -->
    <TABLE NAME="local_q10grades_usermapping" COMMENT="Stores mapping between Moodle users and Q10 students">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Moodle user ID"/>
        <FIELD NAME="q10_student_id" TYPE="char" LENGTH="100" NOTNULL="true" COMMENT="Q10 student ID"/>
        <FIELD NAME="q10_student_code" TYPE="char" LENGTH="100" NOTNULL="false" COMMENT="Q10 student code"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_idx" UNIQUE="true" FIELDS="userid"/>
        <INDEX NAME="q10_student_idx" UNIQUE="false" FIELDS="q10_student_id"/>
      </INDEXES>
    </TABLE>

    <!-- Table to store sync history/logs -->
    <TABLE NAME="local_q10grades_sync_log" COMMENT="Stores grade sync history and logs">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Moodle course ID"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="Student user ID (null for batch syncs)"/>
        <FIELD NAME="gradeitemid" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="Grade item ID"/>
        <FIELD NAME="grade_sent" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="false" COMMENT="Grade value sent to Q10"/>
        <FIELD NAME="q10_response" TYPE="text" NOTNULL="false" COMMENT="Response from Q10 API"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" COMMENT="Status: pending, success, error"/>
        <FIELD NAME="error_message" TYPE="text" NOTNULL="false" COMMENT="Error message if failed"/>
        <FIELD NAME="sync_type" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="manual" COMMENT="Type: manual, scheduled, realtime"/>
        <FIELD NAME="synced_by" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="User who initiated the sync"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="synced_by" TYPE="foreign" FIELDS="synced_by" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_status_idx" UNIQUE="false" FIELDS="courseid, status"/>
        <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

    <!-- Table to store grade item mapping -->
    <TABLE NAME="local_q10grades_itemmapping" COMMENT="Stores mapping between Moodle grade items and Q10 evaluation components">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="gradeitemid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Moodle grade item ID"/>
        <FIELD NAME="q10_component_id" TYPE="char" LENGTH="100" NOTNULL="true" COMMENT="Q10 evaluation component ID"/>
        <FIELD NAME="q10_component_name" TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="Q10 component name for reference"/>
        <FIELD NAME="weight" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" COMMENT="Weight percentage"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="gradeitemid" TYPE="foreign" FIELDS="gradeitemid" REFTABLE="grade_items" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="gradeitemid_idx" UNIQUE="true" FIELDS="gradeitemid"/>
      </INDEXES>
    </TABLE>

    <!-- Table to store Q10 grade items and their mapping to Moodle activities -->
    <TABLE NAME="local_q10grades_items" COMMENT="Stores Q10 grade items and their mapping to Moodle activities">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Moodle course ID"/>
        <FIELD NAME="q10_item_id" TYPE="char" LENGTH="100" NOTNULL="true" COMMENT="Q10 grade item/component ID"/>
        <FIELD NAME="q10_item_name" TYPE="char" LENGTH="255" NOTNULL="true" COMMENT="Q10 item name (e.g., Trabajos, Examenes)"/>
        <FIELD NAME="q10_item_weight" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" COMMENT="Weight in Q10 grading"/>
        <FIELD NAME="calculation_type" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="average" COMMENT="Type: average, weighted, sum, highest, lowest, custom"/>
        <FIELD NAME="selected_activities" TYPE="text" NOTNULL="false" COMMENT="JSON array of selected Moodle grade item IDs"/>
        <FIELD NAME="activity_weights" TYPE="text" NOTNULL="false" COMMENT="JSON object of activity weights for weighted average"/>
        <FIELD NAME="custom_formula" TYPE="text" NOTNULL="false" COMMENT="Custom formula expression"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="courseid_q10item_idx" UNIQUE="true" FIELDS="courseid, q10_item_id"/>
        <INDEX NAME="courseid_sortorder_idx" UNIQUE="false" FIELDS="courseid, sortorder"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
