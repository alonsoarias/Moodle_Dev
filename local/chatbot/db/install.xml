<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/chatbot/db" VERSION="2024052400" COMMENT="XMLDB file for the local chatbot plugin"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_chatbot_logs" COMMENT="Conversation log for the local chatbot widget">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="User who sent the message"/>
        <FIELD NAME="sessionid" TYPE="char" LENGTH="64" NOTNULL="true" COMMENT="Browser session identifier"/>
        <FIELD NAME="message" TYPE="text" NOTNULL="true" COMMENT="Original user message"/>
        <FIELD NAME="response" TYPE="text" NOTNULL="true" COMMENT="Chatbot response"/>
        <FIELD NAME="intent" TYPE="char" LENGTH="50" NOTNULL="false" COMMENT="Matched intent label"/>
        <FIELD NAME="responsetime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Response time in ms"/>
        <FIELD NAME="metadata" TYPE="text" NOTNULL="false" COMMENT="Additional JSON metadata"/>
        <FIELD NAME="feedback" TYPE="char" LENGTH="20" NOTNULL="false" COMMENT="Optional user feedback"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sessionid" UNIQUE="false" FIELDS="sessionid"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
