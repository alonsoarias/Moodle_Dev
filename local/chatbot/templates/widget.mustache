{{!
    @template local_chatbot/widget

    Example context (json):
    {
        "position": "bottom_right",
        "theme": "modern",
        "title": "Virtual Assistant",
        "status": "Online",
        "togglelabel": "Talk to the assistant",
        "placeholder": "Type your message..."
    }
}}
<div id="local-chatbot-container"
     class="chatbot-shell chatbot-{{position}} chatbot-theme-{{theme}} mode-{{mode}}"
     data-position="{{position}}"
     data-theme="{{theme}}"
     style="display:none;">
    <input type="hidden" id="local-chatbot-welcome" value="{{welcome}}">
    <div id="chatbot-widget"
         class="chatbot-popup"
         role="dialog"
         aria-hidden="true"
         aria-label="{{title}}">
        <div id="chatbot-scrollarea" class="chatbot-scrollarea">
            <div class="chatbot-header">
                <div class="chatbot-header-info">
                    <div class="chatbot-avatar" aria-hidden="true">
                        <span class="chatbot-avatar-initial">{{initial}}</span>
                        <span class="chatbot-status-indicator"></span>
                    </div>
                    <div class="chatbot-header-text">
                        <span class="chatbot-title">{{title}}</span>
                        <span class="chatbot-status">{{status}}</span>
                    </div>
                </div>
                <div class="chatbot-header-actions">
                    {{#canexport}}
                        <button class="chatbot-action-btn chatbot-btn-export" type="button" title="{{exportlabel}}">
                            {{#pix}}i/export, core{{/pix}}
                        </button>
                    {{/canexport}}
                    <button class="chatbot-action-btn chatbot-btn-minimize" type="button" title="{{minimizelabel}}">
                        {{#pix}}i/down, core{{/pix}}
                    </button>
                    <button class="chatbot-action-btn chatbot-btn-close" type="button" title="{{closelabel}}">
                        {{#pix}}i/window_close, core{{/pix}}
                    </button>
                </div>
            </div>

            {{#showquickactions}}
            <div id="chatbot-quick-actions" class="chatbot-quick-actions" 
                 role="region" 
                 aria-label="{{quickactionslabel}}">
                <div class="quick-actions-container"></div>
            </div>
            {{/showquickactions}}

            <div class="chatbot-body">
                <div id="chatbot-messages" class="chatbot-messages" role="log" aria-live="polite">
                    <div id="chatbot-welcome-message" class="chatbot-welcome-msg" style="display:none;">
                        <div class="message-avatar bot-avatar">
                            <span>🤖</span>
                        </div>
                        <div class="message-content-wrapper">
                            <div class="message-content">{{welcome}}</div>
                        </div>
                    </div>
                </div>

                {{#showsuggestions}}
                <div id="chatbot-suggestions" class="chatbot-suggestions" style="display:none;"
                     role="region" 
                     aria-label="{{suggestionslabel}}">
                    <div class="suggestions-container"></div>
                </div>
                {{/showsuggestions}}

                <div id="chatbot-typing-indicator" class="chatbot-typing" style="display:none;">
                    <div class="typing-dots">
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                    </div>
                    <span class="typing-text">{{typing}}</span>
                </div>

                <div class="chatbot-input-area">
                    <div class="chatbot-input-wrapper">
                        <textarea id="chatbot-input"
                                  class="chatbot-input"
                                  placeholder="{{placeholder}}"
                                  maxlength="{{maxlength}}"
                                  aria-label="{{placeholder}}"
                                  rows="1"></textarea>
                        <div class="chatbot-input-actions">
                            {{#emojienabled}}
                            <button type="button" 
                                    class="chatbot-icon-button chatbot-btn-emoji"
                                    title="{{emojilabel}}"
                                    aria-label="{{emojilabel}}">
                                😊
                            </button>
                            {{/emojienabled}}
                            
                            <button id="chatbot-send"
                                    type="button" 
                                    class="chatbot-icon-button chatbot-btn-send"
                                    title="{{sendlabel}}"
                                    aria-label="{{sendlabel}}">
                                {{#pix}}t/message, core{{/pix}}
                            </button>
                        </div>
                    </div>
                    <div id="char-count" class="chatbot-char-count">
                        <span id="char-current">0</span>/<span id="char-max">{{maxlength}}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <button id="chatbot-launcher" 
            class="chatbot-launcher"
            type="button"
            aria-label="{{togglelabel}}"
            title="{{talklabel}}">
        <span class="chatbot-launcher-count" 
              data-count="0"
              aria-hidden="true">0</span>
        <span class="chatbot-launcher-label">{{talklabel}}</span>
        <span class="chatbot-launcher-icon chatbot-launcher-open">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" 
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"></path>
            </svg>
        </span>
        <span class="chatbot-launcher-icon chatbot-launcher-close" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" 
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </span>
    </button>
</div>