{{!
    @template local_chatbot/widget

    Example context (json):
    {
        "position": "bottom_right",
        "theme": "modern",
        "title": "Virtual Assistant",
        "status": "Online",
        "togglelabel": "Talk to the assistant",
        "placeholder": "Type your message..."
    }
}}
<div id="local-chatbot-container"
     class="chatbot-shell chatbot-{{position}} chatbot-theme-{{theme}} mode-{{mode}}"
     data-position="{{position}}"
     data-theme="{{theme}}"
     style="display:none;">
    <input type="hidden" id="local-chatbot-welcome" value="{{welcome}}">
    <div id="chatbot-widget"
         class="chatbot-popup"
         role="dialog"
         aria-hidden="true"
         aria-label="{{title}}">
        <div id="chatbot-scrollarea" class="chatbot-scrollarea">
            <div class="chatbot-header">
                <div class="chatbot-header-info">
                    <div class="chatbot-avatar" aria-hidden="true">
                        <span class="chatbot-avatar-initial">{{initial}}</span>
                        <span class="chatbot-status-indicator"></span>
                    </div>
                    <div class="chatbot-header-text">
                        <span class="chatbot-title">{{title}}</span>
                        <span class="chatbot-status">{{status}}</span>
                    </div>
                </div>
                <div class="chatbot-header-actions">
                    {{#canexport}}
                        <button class="chatbot-action-btn chatbot-btn-export" type="button" title="{{exportlabel}}">
                            {{#pix}}i/export, core{{/pix}}
                        </button>
                    {{/canexport}}
                    <button class="chatbot-action-btn chatbot-btn-minimize" type="button" title="{{minimizelabel}}">
                        {{#pix}}t/minus, core{{/pix}}
                    </button>
                    <button class="chatbot-action-btn chatbot-btn-close" type="button" title="{{closelabel}}">
                        {{#pix}}i/close, core{{/pix}}
                    </button>
                </div>
            </div>
            <div id="chatbot-quick-actions"
                 class="chatbot-quick-actions{{^showquickactions}} is-disabled{{/showquickactions}}"
                 role="toolbar"
                 aria-label="{{quickactionslabel}}"
                 {{^showquickactions}}style="display:none;"{{/showquickactions}}>
                <div class="quick-actions-container"></div>
            </div>
            <div id="chatbot-body" class="chatbot-body">
                <div id="chatbot-messages" class="chatbot-messages" role="log" aria-live="polite"></div>
                <div id="chatbot-typing-indicator" class="chatbot-typing-indicator" style="display:none;">
                    <div class="typing-dots" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                    <span class="typing-text">{{typing}}</span>
                </div>
            </div>
            <div id="chatbot-suggestions"
                 class="chatbot-suggestions{{^showsuggestions}} is-disabled{{/showsuggestions}}"
                 role="list"
                 aria-label="{{suggestionslabel}}"
                 {{^showsuggestions}}style="display:none;"{{/showsuggestions}}>
                <div class="suggestions-container"></div>
            </div>
        </div>
        <div id="chatbot-footer" class="chatbot-footer">
            <div class="chatbot-input-container">
                <textarea id="chatbot-input"
                          class="chatbot-input"
                          rows="1"
                          placeholder="{{placeholder}}"
                          aria-label="{{placeholder}}"></textarea>
                <div class="chatbot-input-actions">
                    {{#voiceenabled}}
                        <button class="chatbot-icon-button chatbot-btn-voice" type="button" title="{{voicelabel}}">
                            {{#pix}}i/microphone, core{{/pix}}
                        </button>
                    {{/voiceenabled}}
                    {{#emojienabled}}
                        <button class="chatbot-icon-button chatbot-btn-emoji" type="button" title="{{emojilabel}}">
                            {{#pix}}e/emoticons, core{{/pix}}
                        </button>
                    {{/emojienabled}}
                    <button id="chatbot-send" class="chatbot-icon-button chatbot-btn-send" type="button" title="{{sendlabel}}">
                        {{#pix}}t/send, core{{/pix}}
                    </button>
                </div>
            </div>
            <div class="chatbot-char-count">
                <span id="char-count">0</span>/{{maxlength}}
            </div>
        </div>
    </div>
    <button id="chatbot-launcher"
            class="chatbot-launcher"
            type="button"
            aria-controls="chatbot-widget"
            aria-expanded="false"
            title="{{togglelabel}}">
        <span class="chatbot-launcher-count" data-count="0">0</span>
        <span class="chatbot-launcher-label">{{talklabel}}</span>
        <span class="chatbot-launcher-icon chatbot-launcher-open" aria-hidden="true">{{#pix}}i/chat, core{{/pix}}</span>
        <span class="chatbot-launcher-icon chatbot-launcher-close" aria-hidden="true">{{#pix}}i/close, core{{/pix}}</span>
    </button>
</div>
