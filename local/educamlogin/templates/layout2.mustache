<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="only light">
    <title>Login — Educam</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <link href="{{{css_url}}}" rel="stylesheet">
    {{#has_recaptcha}}
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    {{/has_recaptcha}}
    <style>
        :root {
            --panelTop: {{{panel_top}}};
            --panelMid: {{{panel_mid}}};
            --panelBottom: {{{panel_bottom}}};
            --field: {{{field_bg}}};
            --hint: {{{link_color}}};
            --btn: {{{btn_color}}};
            --btnHover: {{{btn_hover}}};
        }

        .bg-screen::before {
            background-image: url('{{{background_image}}}');
        }
    </style>
</head>
<body>
    <a class="skip-link" href="#login-form">{{str_skiptoform}}</a>

    <header class="brand-header" aria-hidden="true">
        <img class="site-logo" src="{{{logo_educam}}}" alt="Educam" loading="lazy" />
    </header>

    <main class="bg-screen py-4 py-lg-5" role="main">
        <div class="login-panel">
            <div class="logo-mark-wrapper" aria-hidden="true">
                <svg class="logo-mark" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="glow" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0" stop-color="#ffffff" stop-opacity=".95" />
                            <stop offset="1" stop-color="#ffffff" stop-opacity=".85" />
                        </linearGradient>
                    </defs>
                    <rect x="12" y="20" rx="10" ry="10" width="96" height="64" fill="none" stroke="url(#glow)" stroke-width="6" />
                    <circle cx="60" cy="52" r="22" fill="none" stroke="#fff" stroke-width="6" />
                    <path d="M52 52a8 8 0 0 0 8 8h12" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" />
                    <path d="M20 36h20M20 56h16M84 36h16M88 56h12" stroke="#fff" stroke-width="6" stroke-linecap="round" />
                </svg>
            </div>

            <div class="welcome-wrapper text-center">
                <h1 id="login-heading" class="welcome">{{{welcome_text}}}</h1>
                <p id="login-instructions" class="instructions">{{{str_logininstructions}}}</p>
            </div>

            {{#has_error}}
            <div class="alert alert-danger" role="alert" aria-live="assertive">
                {{{errormsg}}}
            </div>
            {{/has_error}}

            <form class="form-area" method="post" action="" id="login-form" aria-labelledby="login-heading" aria-describedby="login-instructions" novalidate>
                <div class="form-floating-group">
                    <div class="mb-3">
                        <label class="form-label" for="username">{{str_username}}:</label>
                        <input type="text" id="username" name="username" class="form-control" placeholder="User123" required autofocus autocomplete="username">
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="password">{{str_password}}:</label>
                        <div class="password-field input-group password-field__wrapper">
                            <input type="password" id="password" name="password" class="form-control password-field__input" placeholder="******" required autocomplete="current-password">
                            <button type="button" class="btn password-toggle" data-target="password" data-label-show="{{str_showpassword}}" data-label-hide="{{str_hidepassword}}" aria-label="{{str_showpassword}}" aria-pressed="false" aria-controls="password" title="{{str_showpassword}}">
                                <span class="visually-hidden password-toggle__label">{{str_showpassword}}</span>
                                <svg class="password-toggle__icon password-toggle__icon--on" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M12 5c-4.8 0-8.8 3.1-10.5 7.5.7 1.9 1.9 3.5 3.4 4.7C6.2 18.7 8.9 20 12 20s5.8-1.3 7.1-2.8c1.5-1.2 2.7-2.8 3.4-4.7C20.8 8.1 16.8 5 12 5zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8z" />
                                    <circle cx="12" cy="12" r="2.5" />
                                </svg>
                                <svg class="password-toggle__icon password-toggle__icon--off" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M3.3 2.3 2 3.6l4 4C3.8 8.6 2.3 10.2 1.5 12c.7 1.9 1.9 3.5 3.4 4.7C6.2 18.7 8.9 20 12 20c2 0 3.8-.5 5.3-1.3l3.4 3.4 1.3-1.3L3.3 2.3zM12 18c-2.5 0-4.6-.9-6.3-2.3a10 10 0 0 1-2.6-3.7c.6-1.3 1.6-2.6 2.9-3.6l2.2 2.2a4 4 0 0 0 5.2 5.2l1.6 1.6c-.9.4-1.9.6-3 .6zm9.1-6a11.6 11.6 0 0 1-3.4 4.7 10 10 0 0 1-2.2 1.4l-2.1-2.1A4 4 0 0 0 9 9.4L6.8 7.2C8.3 6.3 10 5.8 12 5.8c2.5 0 4.6.9 6.3 2.3 1.1.9 2 2 2.6 3.7-.2.4-.3.8-.8 1.2z" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="text-center text-sm-end my-2">
                    <a href="{{{wwwroot}}}/login/forgot_password.php" class="forgot text-decoration-none">{{{str_forgotpassword}}}</a>
                </div>

                {{#has_recaptcha}}
                <div class="recaptcha-container mb-3" role="group" aria-label="reCAPTCHA">
                    <div class="g-recaptcha" data-sitekey="{{{recaptcha_sitekey}}}"></div>
                </div>
                {{/has_recaptcha}}

                {{#has_wantsurl}}
                <input type="hidden" name="wantsurl" value="{{{wantsurl}}}">
                {{/has_wantsurl}}

                <div class="d-grid col-sm-8 mx-sm-auto mt-3 mb-2">
                    <button type="submit" class="btn btn-access">{{{str_login}}}</button>
                </div>
            </form>

            <div class="copyright" role="contentinfo">
                {{{copyright_text}}}
            </div>

            <div class="vendor" aria-hidden="true">
                <img src="{{{logo_americas}}}" alt="" loading="lazy" />
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function() {
            const toggles = document.querySelectorAll('.password-toggle[data-target]');
            toggles.forEach(function(toggle) {
                const targetId = toggle.getAttribute('data-target');
                const target = document.getElementById(targetId);
                if (!target) {
                    return;
                }

                const showLabel = toggle.getAttribute('data-label-show');
                const hideLabel = toggle.getAttribute('data-label-hide');
                const hiddenText = toggle.querySelector('.password-toggle__label');

                const update = function(isVisible) {
                    const label = isVisible ? hideLabel : showLabel;
                    toggle.setAttribute('aria-pressed', isVisible ? 'true' : 'false');
                    toggle.setAttribute('aria-label', label);
                    toggle.setAttribute('title', label);
                    if (hiddenText) {
                        hiddenText.textContent = label;
                    }
                    toggle.classList.toggle('is-visible', isVisible);
                };

                toggle.addEventListener('click', function() {
                    const currentlyPassword = target.getAttribute('type') === 'password';
                    target.setAttribute('type', currentlyPassword ? 'text' : 'password');
                    update(currentlyPassword);
                    target.focus();
                });

                update(target.getAttribute('type') !== 'password');
            });
        })();
    </script>
</body>
</html>
