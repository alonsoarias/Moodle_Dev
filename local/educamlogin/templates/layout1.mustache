<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login — Educam</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <link href="{{{css_url}}}" rel="stylesheet">
    {{#has_recaptcha}}
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    {{/has_recaptcha}}
    <style>
        :root {
            --bg: {{{bg_color}}};
            --panelTop: {{{panel_top}}};
            --panelMid: {{{panel_mid}}};
            --panelBottom: {{{panel_bottom}}};
            --field: {{{field_bg}}};
            --link: {{{link_color}}};
            --btn: {{{btn_color}}};
            --btnHover: {{{btn_hover}}};
        }
    </style>
</head>
<body>
    <!-- Logo Educam fijo en esquina superior derecha -->
    <img class="site-logo" src="{{{logo_educam}}}" alt="educam" />
    
    <!-- Blobs decorativos del fondo -->
    <div class="blob-a"></div>
    <div class="blob-b"></div>

    <section class="vh-100 wrapper d-flex align-items-center">
        <div class="container frame">
            <div class="shell">
                <!-- COLUMNA IZQUIERDA: FOTOGRAFÍA DEL EQUIPO -->
                <div class="left-photo">
                    <img src="{{{team_photo}}}" alt="team">
                </div>
                
                <!-- COLUMNA DERECHA: PANEL DE LOGIN -->
                <div class="right-panel d-flex align-items-center">
                    <div class="right-inner ms-lg-0">
                        <div class="welcome">{{{welcome_text}}}</div>
                        
                        {{#has_error}}
                        <div class="alert alert-danger" role="alert">
                            {{{errormsg}}}
                        </div>
                        {{/has_error}}
                        
                        <form class="inputs" method="post" action="">
                            <div class="mb-3">
                                <label class="form-label">{{{str_username}}}:</label>
                                <input type="text" name="username" class="form-control" placeholder="User123" required autofocus>
                            </div>
                            <div class="mb-1">
                                <label class="form-label">{{{str_password}}}:</label>
                                <input type="password" name="password" class="form-control" placeholder="******" required>
                            </div>
                            <div class="text-start mt-2 mb-3">
                                <a class="hint text-decoration-none" href="{{{wwwroot}}}/login/forgot_password.php">{{{str_forgotpassword}}}</a>
                            </div>
                            
                            {{#has_recaptcha}}
                            <div class="recaptcha-container mb-3">
                                <div class="g-recaptcha" data-sitekey="{{{recaptcha_sitekey}}}"></div>
                            </div>
                            {{/has_recaptcha}}
                            
                            {{#has_wantsurl}}
                            <input type="hidden" name="wantsurl" value="{{{wantsurl}}}">
                            {{/has_wantsurl}}
                            
                            <div class="d-grid" style="max-width:340px;margin-inline:auto">
                                <button type="submit" class="btn btn-access">{{{str_login}}}</button>
                            </div>
                        </form>
                        
                        <div class="copyright mt-3">
                            {{{copyright_text}}}
                        </div>
                        
                        <!-- Logo Americas en el pie del panel -->
                        <div class="vendor">
                            <img src="{{{logo_americas}}}" alt="americas" />
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Dots decorativos inferiores -->
            <div class="dots">
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
