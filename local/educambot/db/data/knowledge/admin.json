{
    "version": "3.0.1",
    "description": "EducamBot - Administracion del sitio (solo admin/manager)",
    "rules": [
        {
            "id": "menu_admin",
            "category": "administracion",
            "pattern": "Menu de administrador",
            "keywords": ["menu administrador", "opciones admin", "que puedo hacer como admin", "administracion sitio", "panel admin", "opciones administrador"],
            "response": "Como administrador tienes acceso a:<br><br><strong>Gestion:</strong><br>- Usuarios y roles<br>- Cursos y categorias<br>- Plugins y temas<br><br><strong>Monitoreo:</strong><br>- Logs y reportes<br>- Tareas programadas<br>- Rendimiento",
            "tags": ["admin", "administrador"],
            "archetypes": ["manager", "siteadmin"],
            "enabled": true,
            "showoptions": true,
            "options": [
                {"text": "Usuarios", "icon": "bi-people-fill", "action": "gestionar usuarios"},
                {"text": "Cursos", "icon": "bi-journal-bookmark-fill", "action": "gestionar cursos"},
                {"text": "Reportes", "icon": "bi-graph-up-arrow", "action": "reportes sitio"},
                {"text": "Menu", "icon": "bi-house", "action": "menu"}
            ]
        },
        {
            "id": "crear_curso",
            "category": "administracion",
            "pattern": "Como creo un curso",
            "keywords": ["crear curso", "nuevo curso", "anadir curso", "agregar curso", "configurar curso", "abrir curso"],
            "response": "Para crear un curso:<br><br>1. <strong>Administracion > Cursos > Gestionar cursos</strong><br>2. Selecciona la categoria<br>3. Clic en <strong>Crear nuevo curso</strong><br>4. Completa: nombre, formato, fechas<br>5. Guarda",
            "tags": ["crear", "curso"],
            "archetypes": ["manager", "coursecreator", "siteadmin"],
            "enabled": true,
            "showoptions": true,
            "options": [
                {"text": "Cursos", "icon": "bi-journal-bookmark-fill", "action": "gestionar cursos"},
                {"text": "Menu", "icon": "bi-house", "action": "menu"}
            ]
        },
