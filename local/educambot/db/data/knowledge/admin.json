            "tags": ["usuarios", "crear"],
            "archetypes": ["manager", "siteadmin"],
            "enabled": true,
            "showoptions": true,
            "options": [
                {"text": "Usuarios", "icon": "bi-people-fill", "action": "gestionar usuarios"},
                {"text": "Menu", "icon": "bi-house", "action": "menu"}
            ]
