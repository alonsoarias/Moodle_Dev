{
    "version": "3.6.0",
    "description": "EducamBot - General questions and main menu for all users - Ampliada",
    "rules": [
        {
            "id": "menu_principal",
            "category": "general",
            "pattern": "Menu principal",
            "keywords": [
                "menu", "inicio", "ayuda", "opciones", "que puedo hacer", "como me ayudas",
                "que opciones tengo", "mostrar menu", "ver menu", "inicio chat", "empezar",
