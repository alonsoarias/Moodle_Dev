            "enabled": true,
            "showoptions": true,
            "options": [
                {"text": "Olvide mi contrasena", "icon": "bi-key", "action": "olvide contrasena"},
                {"text": "Menu principal", "icon": "bi-house", "action": "menu"}
            ]
        },
