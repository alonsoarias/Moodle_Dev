                "como funciona", "guia", "asistencia"
            ],
            "response": "¿En que puedo ayudarte? Selecciona una opcion o escribe tu pregunta:",
            "tags": ["menu", "inicio"],
            "enabled": true,
            "showoptions": true,
            "options": [
                {"text": "Mis cursos", "icon": "bi-collection", "action": "mis cursos"},
                {"text": "Calendario", "icon": "bi-calendar-event", "action": "calendario"},
                {"text": "Mensajes", "icon": "bi-envelope", "action": "mensajes"},
                {"text": "Mi perfil", "icon": "bi-person-circle", "action": "editar perfil"},
                {"text": "Soporte", "icon": "bi-question-circle", "action": "soporte tecnico"}
            ]
        },
        {
            "id": "saludo",
            "category": "general",
            "pattern": "Hola",
            "keywords": ["hola", "buenos dias", "buenas tardes", "buenas noches", "saludos", "hey", "ola", "hi", "hello", "que tal", "como estas", "que hay"],
            "response": "¡Hola! Soy tu asistente virtual en <strong>{{site.name}}</strong>. ¿En que puedo ayudarte hoy?",
