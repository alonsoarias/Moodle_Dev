<div class="local-educambot-admin">
    <div class="local-educambot-admin__header d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-primary" href="{{filters.addurl}}">{{filters.addlabel}}</a>
        <a class="btn btn-secondary" href="{{filters.rulesurl}}">{{filters.ruleslabel}}</a>
    </div>
    <form method="get" class="local-educambot-admin__search mb-3">
        <label for="educambot-knowledge-search" class="sr-only">{{#str}}searchknowledge, local_educambot{{/str}}</label>
        <div class="input-group">
            <input type="text" id="educambot-knowledge-search" name="search" value="{{search.term}}" class="form-control"
                placeholder="{{search.placeholder}}" />
            <button type="submit" class="btn btn-primary">{{#str}}search{{/str}}</button>
            {{#search.issearch}}
                <a class="btn btn-secondary" href="{{search.clearurl}}">{{#str}}clearsearch, local_educambot{{/str}}</a>
            {{/search.issearch}}
        </div>
    </form>
    <form method="get" class="local-educambot-admin__filters mb-3 d-flex flex-wrap gap-2 align-items-end">
        <input type="hidden" name="search" value="{{search.term}}" />
        <div>
            <label class="form-label" for="educambot-knowledge-status">{{#str}}filterstatus, local_educambot{{/str}}</label>
            <select id="educambot-knowledge-status" name="status" class="form-select">
                {{#filters.status.options}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/filters.status.options}}
            </select>
        </div>
        <div>
            <label class="form-label" for="educambot-knowledge-topic">{{#str}}filtertopic, local_educambot{{/str}}</label>
            <select id="educambot-knowledge-topic" name="topic" class="form-select">
                {{#filters.topic.options}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/filters.topic.options}}
            </select>
        </div>
        <div>
            <label class="form-label" for="educambot-knowledge-perpage">{{#str}}perpage, local_educambot{{/str}}</label>
            <input id="educambot-knowledge-perpage" name="perpage" type="number" min="10" max="100" step="5"
                class="form-control" value="{{filters.perpage}}" />
        </div>
        <div>
            <button type="submit" class="btn btn-secondary">{{#str}}applyfilters, local_educambot{{/str}}</button>
        </div>
    </form>
    {{#search.issearch}}
        <div class="alert alert-info">
            {{#hasrecords}}{{search.resultsmessage}}{{/hasrecords}}
            {{^hasrecords}}{{search.noresults}}{{/hasrecords}}
        </div>
    {{/search.issearch}}
    {{^hasrecords}}
        <div class="alert alert-warning">{{search.noentries}}</div>
    {{/hasrecords}}
    {{#hasrecords}}
        <div class="table-responsive">
            <table class="table table-striped" aria-describedby="educambot-knowledge-search">
                <thead>
                    <tr>
                        <th scope="col">{{#str}}title, local_educambot{{/str}}</th>
                        <th scope="col">{{#str}}topics, local_educambot{{/str}}</th>
                        <th scope="col">{{#str}}status, local_educambot{{/str}}</th>
                        <th scope="col">{{#str}}timemodified, local_educambot{{/str}}</th>
                        <th scope="col">{{#str}}actions, local_educambot{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#records}}
                        <tr>
                            <td>{{title}}</td>
                            <td>{{topics}}</td>
                            <td><span class="badge {{statusclass}}">{{status}}</span></td>
                            <td>{{timemodified}}</td>
                            <td>{{{actions}}}</td>
                        </tr>
                    {{/records}}
                </tbody>
            </table>
        </div>
    {{/hasrecords}}
    {{#paging}}
        <div class="mt-3">{{{.}}}</div>
    {{/paging}}
</div>
