{{!
    @template local_educambot/widget

    Educam Bot Widget Template
}}
<div id="educambot-chat" data-service-url="{{serviceurl}}" data-sessionkey="{{sessionkey}}" data-page="{{pageidentifier}}" data-noanswer="{{strings.noanswer}}" data-confidence-label="{{strings.confidence}}" data-loading="{{strings.loading}}" style="display:none;">
    <input type="hidden" id="educambot_initial_message" value="{{#widgetconfig}}{{{widgetconfig}}}{{/widgetconfig}}">

    <div class="educambot-popup">
        <div id="educambot-scrollarea">
            <div class="educambot-header">
                <div class="educambot-info">
                    <div class="educambot-infoname">
                        <span class="educambot-name">{{chatheader}}</span>
                        {{#tagline}}
                        <span class="educambot-status">{{tagline}}</span>
                        {{/tagline}}
                    </div>
                </div>
                <div class="right-icons">
                    <a id="educambot-icon-close" title="{{#str}}cancel, local_educambot{{/str}}" href="#">
                        &times;
                    </a>
                </div>
            </div>
            <div id="educambot-area-messages"></div>
        </div>
        <div id="educambot-sendarea">
            <textarea id="educambot-textarea" placeholder="{{placeholder}}" autocomplete="off"></textarea>
            <div id="educambot-icon-send" title="{{#str}}send, local_educambot{{/str}}">
                ➤
            </div>
        </div>
        <div id="educambot-status"></div>
    </div>

    <div id="educambot-chat-btn">
        <div class="balloon">{{widgettitle}}</div>
        <span class="educambot-icon educambot-open-icon">
            💬
        </span>
        <span class="educambot-icon educambot-close-icon">
            ✕
        </span>
    </div>
</div>
