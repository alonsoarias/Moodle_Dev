<div class="local-educambot" data-service-url="{{serviceurl}}" data-sessionkey="{{sessionkey}}" data-page="{{pageidentifier}}" data-noanswer="{{strings.noanswer}}"
    style="--educambot-primary: {{theme.primary}}; --educambot-accent: {{theme.accent}}; --educambot-background: {{theme.background}}; --educambot-text: {{theme.text}};">
    <button class="local-educambot__toggle" aria-expanded="false" aria-controls="educambot-panel">
        <span class="local-educambot__label">{{widgettitle}}</span>
    </button>
    <div class="local-educambot__panel" id="educambot-panel" hidden>
        <div class="local-educambot__header">
            <strong>{{chatheader}}</strong>
            {{#tagline}}
                <span class="local-educambot__tagline">{{.}}</span>
            {{/tagline}}
            <button type="button" class="local-educambot__close" aria-label="{{#str}}cancel, local_educambot{{/str}}">&times;</button>
        </div>
        <div class="local-educambot__body">
            <div class="local-educambot__intro">{{{widgetintro}}}</div>
            <div class="local-educambot__messages" role="log" aria-live="polite"></div>
            <div class="local-educambot__suggestions" data-label="{{strings.suggestedquestions}}" {{^hasuggestions}}hidden{{/hasuggestions}}>
                <span class="local-educambot__suggestions-title">{{strings.suggestedquestions}}</span>
                <ul>
                    {{#suggestions}}
                        <li><button type="button" data-question="{{text}}">{{text}}</button></li>
                    {{/suggestions}}
                </ul>
            </div>
        </div>
        <div class="local-educambot__footer">
            <label for="educambot-input" class="sr-only">{{placeholder}}</label>
            <input id="educambot-input" type="text" placeholder="{{placeholder}}" autocomplete="off" />
            <button type="button" class="local-educambot__send" aria-label="{{#str}}send, local_educambot{{/str}}">
                <span class="local-educambot__send-icon" aria-hidden="true">{{#pix}} i/send, core {{/pix}}</span>
            </button>
        </div>
        <div class="local-educambot__status" data-loading="{{strings.loading}}" data-confidence-label="{{strings.confidence}}"></div>
    </div>
    <script type="application/json" class="local-educambot__config">{{{widgetconfig}}}</script>
</div>
