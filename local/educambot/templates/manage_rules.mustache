<div class="local-educambot-admin">
    <div class="local-educambot-admin__header d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-primary" href="{{filters.addurl}}">{{filters.addlabel}}</a>
        <a class="btn btn-secondary" href="{{filters.knowledgeurl}}">{{filters.knowledgebuttonlabel}}</a>
    </div>
    <form method="get" class="local-educambot-admin__search mb-3">
        <label for="educambot-rule-search" class="sr-only">{{#str}}searchknowledgebase, local_educambot{{/str}}</label>
        <div class="input-group">
            <input type="text" id="educambot-rule-search" name="search" value="{{search.term}}" class="form-control"
                placeholder="{{search.placeholder}}" />
            <button type="submit" class="btn btn-primary">{{#str}}search{{/str}}</button>
            {{#search.issearch}}
                <a class="btn btn-secondary" href="{{search.clearurl}}">{{#str}}clearsearch, local_educambot{{/str}}</a>
            {{/search.issearch}}
        </div>
    </form>
    <form method="get" class="local-educambot-admin__filters mb-3 d-flex flex-wrap gap-2 align-items-end">
        <input type="hidden" name="search" value="{{search.term}}" />
        <div>
            <label class="form-label" for="educambot-rule-status">{{#str}}filterstatus, local_educambot{{/str}}</label>
            <select id="educambot-rule-status" name="status" class="form-select">
                {{#filters.status.options}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/filters.status.options}}
            </select>
        </div>
        <div>
            <label class="form-label" for="educambot-rule-suggested">{{#str}}filtersuggested, local_educambot{{/str}}</label>
            <select id="educambot-rule-suggested" name="suggested" class="form-select">
                {{#filters.suggested.options}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/filters.suggested.options}}
            </select>
        </div>
        <div>
            <label class="form-label" for="educambot-rule-perpage">{{#str}}perpage, local_educambot{{/str}}</label>
            <input id="educambot-rule-perpage" name="perpage" type="number" min="10" max="100" step="5"
                class="form-control" value="{{filters.perpage}}" />
        </div>
        <div>
            <button type="submit" class="btn btn-secondary">{{#str}}applyfilters, local_educambot{{/str}}</button>
        </div>
    </form>
    {{#search.issearch}}
        <div class="alert alert-info">
            {{#hasrecords}}{{search.resultsmessage}}{{/hasrecords}}
            {{^hasrecords}}{{search.noresults}}{{/hasrecords}}
        </div>
    {{/search.issearch}}
    {{^hasrecords}}
        <div class="alert alert-warning">{{search.noentries}}</div>
    {{/hasrecords}}
    {{#hasrecords}}
        <div class="table-responsive">
            <table class="table table-striped" aria-describedby="educambot-rule-search">
                <thead>
                    <tr>
                        <th scope="col">{{#str}}pattern, local_educambot{{/str}}</th>
                        {{#search.showconfidence}}
                            <th scope="col">{{#str}}confidence, local_educambot{{/str}}</th>
                        {{/search.showconfidence}}
                        <th scope="col">{{#str}}status, local_educambot{{/str}}</th>
                        <th scope="col">{{#str}}suggested, local_educambot{{/str}}</th>
                        <th scope="col">{{#str}}timemodified, local_educambot{{/str}}</th>
                        <th scope="col">{{#str}}actions, local_educambot{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#records}}
                        <tr>
                            <td>{{pattern}}</td>
                            {{#hasconfidence}}
                                <td>{{confidence}}</td>
                            {{/hasconfidence}}
                            {{^hasconfidence}}
                                {{#search.showconfidence}}<td>—</td>{{/search.showconfidence}}
                            {{/hasconfidence}}
                            <td><span class="badge {{statusclass}}">{{status}}</span></td>
                            <td>{{suggested}}</td>
                            <td>{{timemodified}}</td>
                            <td>{{{actions}}}</td>
                        </tr>
                    {{/records}}
                </tbody>
            </table>
        </div>
    {{/hasrecords}}
    {{#paging}}
        <div class="mt-3">{{{.}}}</div>
    {{/paging}}
</div>
